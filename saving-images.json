{"version":3,"kind":"Article","sha256":"be7710d6ec0ed1bd23767e5210680bc2b77b6cd74c159fc1a499b0b2e6f81a3a","slug":"saving-images","location":"/weather_technology/surface_plots/saving_images.md","dependencies":[],"frontmatter":{"title":"Saving Images","content_includes_title":false,"license":{"content":{"id":"CC-BY-4.0","url":"https://creativecommons.org/licenses/by/4.0/","name":"Creative Commons Attribution 4.0 International","note":"All non-code content is licensed under CC-BY-4.0","free":true,"CC":true},"code":{"id":"Apache-2.0","url":"https://opensource.org/licenses/Apache-2.0","name":"Apache License 2.0","note":"All code content is licensed under Apache-2.0","free":true,"osi":true}},"github":"https://github.com/kgoebber/metpy_thebook","edit_url":null,"numbering":{"title":{"enabled":false,"offset":2},"equation":{"enabled":false},"figure":{"enabled":true,"continue":true}},"keywords":["metpy","python","meteorology","weather"],"copyright":"2026","settings":{"output_stderr":"remove-warn","output_matplotlib_strings":"remove"},"source_url":"https://github.com/kgoebber/metpy_thebook/blob/main/weather_technology/surface_plots/saving_images.md","exports":[{"format":"md","filename":"saving_images.md","url":"https://kgoebber.github.io/metpy_thebook//build/saving_images-9af091781e701b21398ead32181defe6.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"Previously we have created maps, but they were only visible within\nthe Jupyter environment. What if I want to save the image that I\ncreated? There is only one small addition to make to your cell where you\ncreate your image:","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"fnowbSHu9J"}],"key":"xM45iEHhlM"},{"type":"paragraph","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"inlineCode","value":"pc.save('test.png')","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"YrzdOoyaPk"}],"key":"khM5wXClp8"},{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"This will save the same image that is shown in your notebook to the\nlocal working directory (likely your working directory). It is saving to\nthe name you give the file between the quote marks (in this case\n","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"xTum4tKjvv"},{"type":"strong","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"test.png","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"b00GqRj0aO"}],"key":"sYDe74SMlQ"},{"type":"text","value":"). That’s it. It really is that simple.","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"unHwysSfio"}],"key":"ct9kUlK81x"},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"There are a few different types of images you can save as, the most\ncommon being the PNG (portable network graphic), but you can also save\nas a JPG, PDF, PS, and TIF. Just switch out the .png for the desired\ngraphical output type.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"w9NjKVWl12"}],"key":"k1bNDmrmMG"},{"type":"paragraph","position":{"start":{"line":20,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"Additionally, you can set other parameters about how the image will\nsave. We’ll highlight two of them here, but for all of the available\noptions go the Matplotlib help pages for\n","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"MetzcLqP3k"},{"type":"link","url":"https://matplotlib.org/stable/api/_as_gen/matplotlib.pyplot.savefig.html","children":[{"type":"text","value":"savefig","key":"XeEB09U4cs"}],"urlSource":"https://matplotlib.org/stable/api/_as_gen/matplotlib.pyplot.savefig.html","key":"cnYRRYkUfS"}],"key":"agprtozeMu"},{"type":"heading","depth":2,"position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"Common (Good) Options","position":{"start":{"line":25,"column":1},"end":{"line":25,"column":1}},"key":"lK96858aCB"}],"identifier":"common-good-options","label":"Common (Good) Options","html_id":"common-good-options","implicit":true,"key":"gjV0m3p6qa"},{"type":"heading","depth":3,"position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"strong","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"dpi","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"AL98bc3iKm"}],"key":"bWFt6W735Y"}],"identifier":"dpi","label":"dpi","html_id":"dpi","implicit":true,"key":"l8CJBzeohd"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":28,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":28,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"This setting is to allow you to specify a “dots per inch”,\nwhich will give you a nicer looking image with a higher value. Common\nvalue to get a good image is 150.","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"lHJD11Ey4I"}],"key":"lGe3WLClDz"}],"key":"EQLkJurvUd"}],"key":"ba7P8cYJsj"},{"type":"heading","depth":3,"position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"strong","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"bbox_inches","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"Zxym2Gi6K6"}],"key":"l1aoe8C281"}],"identifier":"bbox-inches","label":"bbox_inches","html_id":"bbox-inches","implicit":true,"key":"y6SeO4y73a"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":33,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":33,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"This setting is set to ‘tight’ to remove excessive\nwhite space surrounding the image. It is best that this always be set to\nTrue (the default is false).","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"trxa5jfgdd"}],"key":"JwQk5JGjtP"}],"key":"tS4mlZBzo1"}],"key":"wDb7DmtNHx"},{"type":"paragraph","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"So, putting it all together, a good line for saving a file is:","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"s6h53e2szP"}],"key":"hvqLFKJRLl"},{"type":"paragraph","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"inlineCode","value":"pc.save('test.png', dpi=150, bbox_inches='tight')","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"we21z8bOWy"}],"key":"hNoZ3scdLg"},{"type":"paragraph","position":{"start":{"line":41,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Simply change the name within the quote marks to save to a different\nname (good habit is to name the image something unique each time so as\nnot to accidentally overwrite something you really want to keep!).","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"Jv1WUvwxxp"}],"key":"L8LBYJ8A8a"},{"type":"heading","depth":2,"position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"Downloading Images","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"fa5ybDoRfL"}],"identifier":"downloading-images","label":"Downloading Images","html_id":"downloading-images","implicit":true,"key":"VQYG55QmFE"},{"type":"paragraph","position":{"start":{"line":47,"column":1},"end":{"line":52,"column":1}},"children":[{"type":"text","value":"To download an image to your local machine, find the file you wish to\ndownload (most likely an image file), right-click on the file and a\ndialogue box should appear and find the option to “Download”. Depending\non the settings of your web browser, you’ll either be asked where to\nsave the file, or it will save to your Downloads (or other designated)\nfolder.","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"Rna6xxQqwV"}],"key":"EeUvRkX51h"}],"key":"S5R3xMuqU7"}],"key":"dcHVsyHl5W"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Full Surface Station Model Plotting","url":"/full-surface-station-model","group":"Introduction to Weather Technology using MetPy"},"next":{"title":"Map Making Summary","url":"/map-making-summary","group":"Introduction to Weather Technology using MetPy"}}},"domain":"http://localhost:3001"}