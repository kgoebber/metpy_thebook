end":{"line":24,"column":1}},"children":[{"type":"text","value":"westward tilt","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"TmCzCoaN5D"}],"key":"LdLFNx9OH6"},{"type":"text","value":" with height is essential to the continued\nstrengthening of the mid-latitude cyclone.","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"p9ksnOFEKt"}],"key":"I1PzOorVeB"}],"key":"EOdURwxMbp"}],"key":"NSBpe87y2D"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Pre-Environment Stage","url":"/midlatitude-cyclone-pre-environment","group":"Introduction to Weather Technology using MetPy"},"next":{"title":"Mature Stage","url":"/midlatitude-cyclone-mature","group":"Introduction to Weather Technology using MetPy"}}},"domain":"http://localhost:3001"}