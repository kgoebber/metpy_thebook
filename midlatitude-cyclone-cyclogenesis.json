end":{"line":24,"column":1}},"children":[{"type":"text","value":"westward tilt","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"OyUHFKumKI"}],"key":"Gwey5rlFpd"},{"type":"text","value":" with height is essential to the continued\nstrengthening of the mid-latitude cyclone.","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"KhrwT3g8Lf"}],"key":"RdbtiN6tQm"}],"key":"omrRoP4C5J"}],"key":"WVB1nt2rHZ"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Pre-Environment Stage","url":"/midlatitude-cyclone-pre-environment","group":"Introduction to Weather Technology using MetPy"},"next":{"title":"Mature Stage","url":"/midlatitude-cyclone-mature","group":"Introduction to Weather Technology using MetPy"}}},"domain":"http://localhost:3001"}