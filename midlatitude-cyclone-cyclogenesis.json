line":3,"column":1},"end":{"line":3,"column":1}},"key":"v3ryLDbIFv"},{"type":"crossReference","kind":"figure","identifier":"cyclogenesis","label":"cyclogenesis","children":[{"type":"text","value":"Fig. ","key":"z4biFyki3U"},{"type":"text","value":"26","key":"Lkx5Fu5P4Y"}],"template":"Figure %s","enumerator":"26","resolved":true,"html_id":"cyclogenesis","key":"ytozmi7Opr"},{"type":"text","value":"). There are now\nfronts defined with a warm front typically east of the cyclone center\nand a cold front south and west of the cyclone center. The pressure\ntroughs in association with the fronts begin to develop.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"yIEK53oIo5"}],"key":"dYlw6wZY3Z"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/build/midlat_cyclone_cyclo-1baaf5ab238fce65ca323044569c3f5f.png","alt":"Cyclogenesis stage of a Mid-latitude Cyclone","width":"650px","align":"center","key":"bqrEH9boLz","urlSource":"../../images/midlat_cyclone_cyclogenesis.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":19,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"cyclogenesis","identifier":"cyclogenesis","html_id":"cyclogenesis","enumerator":"26","children":[{"type":"text","value":"Figure ","key":"DGyc31lmKE"},{"type":"text","value":"26","key":"E3MZc091ry"},{"type":"text","value":":","key":"x9NkRcZTIS"}],"template":"Figure %s:","key":"wgQKNla7c3"},{"type":"text","value":"A schematic diagram of a surface cyclone during the cyclogenesis\nstage of development at the surface and 500 hPa with location of\nlow-level fronts for spatial reference.","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"UJUvDNtJyk"}],"key":"D0ozLAf1iY"}],"key":"tMI8PdmYlU"}],"label":"cyclogenesis","identifier":"cyclogenesis","enumerator":"26","html_id":"cyclogenesis","key":"Nc5R0dyNbY"},{"type":"paragraph","position":{"start":{"line":24