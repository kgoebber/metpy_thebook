line":3,"column":1},"end":{"line":3,"column":1}},"key":"yuVRFqDjjM"},{"type":"crossReference","kind":"figure","identifier":"cyclogenesis","label":"cyclogenesis","children":[{"type":"text","value":"Fig. ","key":"AGKjuW5e1t"},{"type":"text","value":"26","key":"GOFgoTYuEz"}],"template":"Figure %s","enumerator":"26","resolved":true,"html_id":"cyclogenesis","key":"PG12A9cfjj"},{"type":"text","value":"). There are now\nfronts defined with a warm front typically east of the cyclone center\nand a cold front south and west of the cyclone center. The pressure\ntroughs in association with the fronts begin to develop.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"u1UeBmBNbj"}],"key":"uqcbQHG5yv"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/build/midlat_cyclone_cyclo-1baaf5ab238fce65ca323044569c3f5f.png","alt":"Cyclogenesis stage of a Mid-latitude Cyclone","width":"650px","align":"center","key":"MzxtVEhdl7","urlSource":"../../images/midlat_cyclone_cyclogenesis.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":19,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"cyclogenesis","identifier":"cyclogenesis","html_id":"cyclogenesis","enumerator":"26","children":[{"type":"text","value":"Figure ","key":"Lp4w3KLEdl"},{"type":"text","value":"26","key":"cZLllS4ygi"},{"type":"text","value":":","key":"ukZuc8x4lu"}],"template":"Figure %s:","key":"VvpXWoj5HV"},{"type":"text","value":"A schematic diagram of a surface cyclone during the cyclogenesis\nstage of development at the surface and 500 hPa with location of\nlow-level fronts for spatial reference.","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"key":"vAddNfwLcG"}],"key":"QIsS31nQvq"}],"key":"pLXIOIT5ko"}],"label":"cyclogenesis","identifier":"cyclogenesis","enumerator":"26","html_id":"cyclogenesis","key":"aUpqLgopVi"},{"type":"paragraph","position":{"start":{"line":24