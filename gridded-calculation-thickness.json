{"version":3,"kind":"Notebook","sha256":"92e8d2705e55232eccd43779bf797120475a02599ec44f6a853e12445b87a8a2","slug":"gridded-calculation-thickness","location":"/weather_technology/metpy_calculations/gridded_calculation_thickness.ipynb","dependencies":[],"frontmatter":{"title":"Thickness Calculation","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"metpy_book","language":"python"},"license":{"content":{"id":"CC-BY-4.0","url":"https://creativecommons.org/licenses/by/4.0/","name":"Creative Commons Attribution 4.0 International","note":"All non-code content is licensed under CC-BY-4.0","free":true,"CC":true},"code":{"id":"Apache-2.0","url":"https://opensource.org/licenses/Apache-2.0","name":"Apache License 2.0","note":"All code content is licensed under Apache-2.0","free":true,"osi":true}},"github":"https://github.com/kgoebber/metpy_thebook","edit_url":null,"numbering":{"title":{"enabled":false,"offset":2},"equation":{"enabled":false},"figure":{"enabled":true,"continue":true}},"keywords":["metpy","python","meteorology","weather"],"copyright":"2026","settings":{"output_stderr":"remove-warn","output_matplotlib_strings":"remove"},"source_url":"https://github.com/kgoebber/metpy_thebook/blob/main/weather_technology/metpy_calculations/gridded_calculation_thickness.ipynb","exports":[{"format":"ipynb","filename":"gridded_calculation_thickness.ipynb","url":"https://kgoebber.github.io/metpy_thebook//build/gridded_calculation_-7e35d56b091bb91514bea6768c93e42c.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"This notebook demonstrates a simple calculation for 1000-500-hPa thickness by adding it to the DataArray.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"k2RAnvBX9J"}],"key":"aMkWYzhSK8"}],"key":"Gosoqx7L5a"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Import Packages","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Cy9vChoJZm"}],"identifier":"import-packages","label":"Import Packages","html_id":"import-packages","implicit":true,"key":"UALuVoegNx"}],"key":"GTiRl5XPW2"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from datetime import datetime\n\nfrom metpy.plots import declarative\nfrom metpy.units import units\nimport numpy as np\nimport xarray as xr","key":"ZXo47Q6cjV"},{"type":"outputs","id":"1DdqbGDi5RruUiVPC-G7W","children":[],"key":"klcO7Nnlir"}],"key":"CsyHMTl9NU"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Get Data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"P1T6a0PMF9"}],"identifier":"get-data","label":"Get Data","html_id":"get-data","implicit":true,"key":"BuVBdw1HsA"}],"key":"O4wkMeBbCO"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Set the date/time of the model run\ndate = datetime(2017, 2, 24, 12)\n\n# Remote access to the dataset from the NCEI Archive\nds = xr.open_dataset('https://tds.gdex.ucar.edu/thredds/dodsC/files/g/d084001/'\n                    f'{date:%Y}/{date:%Y%m%d}/gfs.0p25.{date:%Y%m%d%H}.f000.grib2')\n\n# Subset data to be just over the U.S. for plotting purposes\nds = ds.sel(lat=slice(70,10), lon=slice(360-140, 360-60))","key":"LlfuDmT2nz"},{"type":"outputs","id":"lUmXGiYipol6DiO-7VLkz","children":[],"key":"eTBlQTId2g"}],"key":"fUqIygFHk8"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"A Simple Calculation","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"PgxY8We8YF"}],"identifier":"a-simple-calculation","label":"A Simple Calculation","html_id":"a-simple-calculation","implicit":true,"key":"UA2emZY6zI"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"1000-500-hPa Thickness = (Heights at 500 hPa) - (Heights at 1000 hPa)","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"OiE3YZ7a9U"}],"key":"ZBHMhWopZs"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Easy to do subtraction with a data array and store it directly back into the dataset (ds). In order to do this well, we’ll need to quantify the variable (e.g., attach units to the variable we’re pulling from our Dataset. Then we’ll do the calculation and dequantify it so we are back in a more native xarray DataArray format.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"KgmL3ZAQjV"}],"key":"mhvdAkYmg8"}],"key":"EyVF4nmCJ2"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"hght_500 = ds.Geopotential_height_isobaric.metpy.sel(time=date,\n    vertical=500 * units.hPa).metpy.quantify()\nhght_1000 = ds.Geopotential_height_isobaric.metpy.sel(time=date,\n    vertical=1000 * units.hPa).metpy.quantify()\nds['thickness'] = (hght_500 - hght_1000).metpy.dequantify()","key":"kzGNH7e4UR"},{"type":"outputs","id":"npixMeA091GJudl6Bx6tZ","children":[],"key":"ipBePird3o"}],"key":"tF8zbMcp7o"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plot Data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vcSTxj1ZtS"}],"identifier":"plot-data","label":"Plot Data","html_id":"plot-data","implicit":true,"key":"QDrfHw3i6u"},{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Note","key":"f1tRYuQnAB"}],"key":"snrktygmvG"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"Since we subset by time, as well as by vertical level, when isolating the 500 and 1000-hPa geopotential heights above, we no longer need to subst by those dimensions when plotting. So we’ll need to set the ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"o83wJrecju"},{"type":"emphasis","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"level","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"aCR1lk9Chx"}],"key":"TH7bP07uLx"},{"type":"text","value":" and ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"Brd4O4SFIL"},{"type":"emphasis","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"time","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"qA34neFLuW"}],"key":"SFo9TM1zpB"},{"type":"text","value":" attributes to ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"ArMTZHaaUI"},{"type":"inlineCode","value":"None","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"PC5LDUiSqs"},{"type":"text","value":".","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"bw5cQw7aXN"}],"key":"JwcRH6lGKD"}],"key":"vOC7dPFbs6"}],"key":"MxvVq2sLCG"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Set attributes for plotting contours\ncntr = declarative.ContourPlot()\ncntr.data = ds\ncntr.field = 'thickness'\ncntr.level = None\ncntr.time = None\ncntr.contours = list(range(0, 10000, 60))\ncntr.linecolor = 'red'\ncntr.linestyle = 'dashed'\ncntr.clabels = True\n\ncntr2 = declarative.ContourPlot()\ncntr2.data = ds\ncntr2.field = 'Geopotential_height_isobaric'\ncntr2.level = 500 * units.hPa\ncntr2.time = date\ncntr2.contours = range(0, 10000, 60)\ncntr2.linecolor = 'black'\ncntr2.linestyle = 'solid'\ncntr2.clabels = True\n\n# Set the attributes for the map\n# and put the contours on the map\npanel = declarative.MapPanel()\npanel.area = [-125, -74, 20, 55]\npanel.projection = 'lcc'\npanel.layers = ['states', 'coastline', 'borders']\npanel.left_title = f'1000-500-hPa Thickness at {date}'\npanel.right_title = f'Valid: {date:%Y-%d-%m %H:%M} UTC'\npanel.plots = [cntr, cntr2]\n\n# Set the attributes for the panel\n# and put the panel in the figure\npc = declarative.PanelContainer()\npc.size = (15, 15)\npc.panels = [panel]\n\n# Show the figure\npc.show()","key":"ksxBhCIQgL"},{"type":"outputs","id":"shyTUZN2fRCmKrBYlciF-","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1500x1500 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"1ad233818ac6194802d7bc75d02bac85","path":"https://kgoebber.github.io/metpy_thebook//build/1ad233818ac6194802d7bc75d02bac85.png"}}},"key":"BvCbNGoz3M"}],"key":"pNkyVhmoZg"}],"key":"jPbDXZNSQ5"}],"key":"R8CG3SspO8"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Simple Calculations","url":"/simple-calcs","group":"Introduction to Weather Technology using MetPy"},"next":{"title":"Scaling Parameters","url":"/scaling-values","group":"Introduction to Weather Technology using MetPy"}}},"domain":"http://localhost:3000"}