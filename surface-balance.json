{"version":3,"kind":"Article","sha256":"5a29765b8e51e5c6dfbdad6beb32f8ce5bb26727b004ecd62932f4b0574c1d49","slug":"surface-balance","location":"/weather_technology/force_balances/surface_balance.md","dependencies":[],"frontmatter":{"title":"Guldberg-Mohn Balance (Surface Balance)","content_includes_title":false,"license":{"content":{"id":"CC-BY-4.0","url":"https://creativecommons.org/licenses/by/4.0/","name":"Creative Commons Attribution 4.0 International","note":"All non-code content is licensed under CC-BY-4.0","free":true,"CC":true},"code":{"id":"Apache-2.0","url":"https://opensource.org/licenses/Apache-2.0","name":"Apache License 2.0","note":"All code content is licensed under Apache-2.0","free":true,"osi":true}},"github":"https://github.com/kgoebber/metpy_thebook","edit_url":null,"numbering":{"title":{"enabled":false,"offset":2},"equation":{"enabled":false},"figure":{"enabled":true,"continue":true}},"keywords":["metpy","python","meteorology","weather"],"copyright":"2026","settings":{"output_stderr":"remove-warn","output_matplotlib_strings":"remove"},"source_url":"https://github.com/kgoebber/metpy_thebook/blob/main/weather_technology/force_balances/surface_balance.md","thumbnail":"/build/surface_balance_exam-14747850506ab4321238d9d01bd8e5a1.png","exports":[{"format":"md","filename":"surface_balance.md","url":"/build/surface_balance-f1c518b02a7c448ada5b74e18f4a216e.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"At and near the surface, friction begins to affect atmospheric flows by\nslowing the wind. Because friction acts to slow the wind, the Coriolis\nforce subsequently does not turn the wind as much and therefore the wind\nwill flow across isobars. This is known as the Guldberg-Mohn force\nbalance and can be written algebraically as,","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"dCdcL5G7QX"}],"key":"PvqsEGc7Qh"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"$$\n0 = -\\frac{1}{\\rho}\\frac{\\Delta p}{\\Delta x} + f V - k U","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"wcFtfZSzcE"}],"key":"hiRICqz6xu"},{"type":"paragraph","position":{"start":{"line":12,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"0 = -\\frac{1}{\\rho}\\frac{\\Delta p}{\\Delta y} - f U - k V\n$$","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"kFSn1jlDfm"}],"key":"nDDEltEv1f"},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"The greater the roughness of the surface, the stronger the friction,\nthe greater the angle that the flow will cross the isobars. In\n","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"RMx68bSTC9"},{"type":"crossReference","kind":"figure","identifier":"surfacebalance","label":"surfacebalance","children":[{"type":"text","value":"Figure ","key":"VRvLzE7RiZ"},{"type":"text","value":"21","key":"dRwHpG0Pbi"}],"template":"Figure %s","enumerator":"21","resolved":true,"html_id":"surfacebalance","key":"yDvCOfsp75"},{"type":"text","value":" notice that near the center\nof low pressure just north of Nova Scotia, CN, there are a number of\nwind barbs that are crossing the isobars and heading into the low center.\nThe friction near the surface is causing the speed of the wind to slow down,\nthus reducing the overall Coriolis force deflection and yielding a wind\nthat is not parallel to the isobars and ultimately goes into a low.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"rRIJpY03Kp"}],"key":"QkuK0nMzPh"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/build/surface_balance_exam-14747850506ab4321238d9d01bd8e5a1.png","alt":"Su