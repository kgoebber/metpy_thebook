:"gm7uRlql5EPWDYS0RFlYA","children":[],"key":"DHz3tRtYdR"}],"key":"EZ29IrN3pE"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Get Data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"JTVCf9QOOM"}],"identifier":"get-data","label":"Get Data","html_id":"get-data","implicit":true,"key":"xYngS1MbRo"}],"key":"cTaWBdqz3V"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"date = datetime.now(UTC).replace(tzinfo=None)\n\n# Create variables for URL generation\nregion = 'CONUS'\nchannel = 9\nsatellite = 'east'\n\n# We want to match something like:\n# https://thredds-test.unidata.ucar.edu/thredds/catalog/satellite/goes16/GOES16/Mesoscale-1/Channel08/20181113/catalog.html\n\n# Construct the data_url string\ndata_url = (f'https://thredds.ucar.edu/thredds/catalog/satellite/goes/{satellite}/'\n            f'products/CloudAndMoistureImagery/{region}/Channel{channel:02d}/'\n            f'{date:%Y%m%d}/catalog.xml')\n\n# Get list of files available for particular day\ncat = TDSCatalog(data_url)\n\n# Grab dataset for desired time\ndataset = cat.datasets.filter_time_nearest(date, regex=r'_s(?P<strptime>\\d{13})', strptime='%Y%j%H%M%S')\n\n# Open most recent file available\nds = dataset.remote_access(service='OPENDAP', use_xarray=True)\n\n# Apply a square root correction for visible imagery only\nif channel == 2:\n    ds['Sectorized_CMI'].values = np.sqrt(ds['Sectorized_CMI'].values)\n\n# Grab time from file and make into datetime object for plotting and later data access\nvtime = ds.time.values.astype('datetime64[ms]').astype('O')","key":"g3CSXDOEs5"},{"type":"outputs","id":"0TiRBUd4H-vrjFpnC-2gi","children":[],"key":"JivAuv5NTq"}],"key":"XjmbH8mNbQ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"lin