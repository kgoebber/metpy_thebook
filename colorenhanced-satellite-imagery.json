rue,"value":"from datetime import datetime, UTC\n\nimport metpy.calc as mpcalc\nfrom metpy.plots import declarative\nfrom metpy.units import units\nimport numpy as np\nfrom siphon.catalog import TDSCatalog\nimport xarray as xr","key":"CJ4luVKkXj"},{"type":"outputs","id":"sNWQ-OQOfeb61t570wDeq","children":[],"key":"UQFzziQx1v"}],"key":"oUAd8plUSt"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Get Data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"pJ3lFJ49jQ"}],"identifier":"get-data","label":"Get Data","html_id":"get-data","implicit":true,"key":"emrpdSCCqL"}],"key":"vgY548eqlM"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"date = datetime.now(UTC).replace(tzinfo=None)\n\n# Create variables for URL generation\nregion = 'CONUS'\nchannel = 9\nsatellite = 'east'\n\n# We want to match something like:\n# https://thredds-test.unidata.ucar.edu/thredds/catalog/satellite/goes16/GOES16/Mesoscale-1/Channel08/20181113/catalog.html\n\n# Construct the data_url string\ndata_url = (f'https://thredds.ucar.edu/thredds/catalog/satellite/goes/{satellite}/'\n            f'products/CloudAndMoistureImagery/{region}/Channel{channel:02d}/'\n            f'{date:%Y%m%d}/catalog.xml')\n\n# Get list of files available for particular day\ncat = TDSCatalog(data_url)\n\n# Grab dataset for desired time\ndataset = cat.datasets.filter_time_nearest(date, regex=r'_s(?P<strptime>\\d{13})', strptime='%Y%j%H%M%S')\n\n# Open most recent file available\nds = dataset.remote_access(service='OPENDAP', use_xarray=True)\n\n# Apply a square root correction for visible imagery only\nif channel == 2:\n    ds['Sectorized_CMI'].values = np.sqrt(ds['Sectorized_CMI'].values)\n\n# Grab time from file and make into datetime object for plotting and later data access\nvtime = ds.time.values.astype('datetime64[ms]').astype('O')","key":"x4pt3T6Agl"},{"type":"outputs","id":"uo_Z0RJgk4PY6H1pyD-Nu","children":[],"key":"m5AW0xpcWz"}],"key":"OCkPQWtFKz"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plot Imagery","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"SOwCVqr0mI"}],"identifier":"plot-imagery","label":"Plot Imagery","html_id":"plot-imagery","implicit":true,"key":"fkApX6uA4O"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Color enhancement colormaps are available from MetPy and can be found at: ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"EcznYejyef"},{"type":"link","url":"https://unidata.github.io/MetPy/latest/api/generated/metpy.plots.ctables.html","children":[{"type":"text","value":"https://​unidata​.github​.io​/MetPy​/latest​/api​/generated​/metpy​.plots​.ctables​.html","key":"xu4YiAZtdL"}],"urlSource":"https://unidata.github.io/MetPy/latest/api/generated/metpy.plots.ctables.html","key":"ZvJ9Es3PBB"}],"key":"ZJ8aPh63fW"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Water Vapor Colormaps:","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"BeqXpnsNyj"}],"key":"jw9qHe7YyJ"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":6,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"WVCIMSS_r","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"eZo2nnldsI"}],"key":"fxJ4S4SHz8"}],"key":"ozYxATsVb8"},{"type":"listItem","spread":true,"position":{"s