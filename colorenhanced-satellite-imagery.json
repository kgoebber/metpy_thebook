ue":"/data/ldmdata/satellite","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"LteaxpazIY"},{"type":"text","value":" for both GOES-16 and GOES-17 or at ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"GHLMlVHuQn"},{"type":"inlineCode","value":"https://thredds.ucar.edu/thredds/idd/satellite.html","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"T19ZLQoTIp"},{"type":"text","value":". We’ll be using the remote data source in this notebook. There are a couple of different sectors that we can view the data from, but the most common for synoptic-dynamic purposes would be the CONUS projection. Data are available every 5 min.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Z0dRorJLA6"}],"key":"Tu1rTD4Q8x"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"For this plotting we are doing to use the declarative plotting syntax using Python and the MetPy module.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"TlipkMDsOS"}],"key":"beI6zJ5vkb"}],"key":"GQ4vZzBqg4"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Import Packages","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KRpvXNGjZZ"}],"identifier":"import-packages","label":"Import Packages","html_id":"import-packages","implicit":true,"key":"KkiBDEP2nc"}],"key":"fQJSfU00iT"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from datetime import datetime, UTC\n\nimport metpy.calc as mpcalc\nfrom metpy.plots import declarative\nfrom metpy.units import units\nimport numpy as np\nfrom siphon.catalog import TDSCatalog\nimport xarray as xr","key":"X1ESGoTIe1"},{"type":"outputs","id":"eXvulXwtvJ75q1H0cD3yu","children":[],"key":"cdqzXPtFDW"}],"key":"zc7cYETha8"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Get Data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"LJN6UK3AgW"}],"identifier":"get-data","label":"Get Data","html_id":"get-data","implicit":true,"key":"GuHNaObctl"}],"key":"cZorq38xgb"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"date = datetime.now(UTC).replace(tzinfo=None)\n\n# Create variables for URL generation\nregion = 'CONUS'\nchannel = 9\nsatellite = 'east'\n\n# We want to match something like:\n# https://thredds-test.unidata.ucar.edu/thredds/catalog/satellite/goes16/GOES16/Mesoscale-1/Channel08/20181113/catalog.html\n\n# Construct the data_url string\ndata_url = (f'https://thredds.ucar.edu/thredds/catalog/satellite/goes/{satellite}/'\n            f'products/CloudAndMoistureImagery/{region}/Channel{channel:02d}/'\n            f'{date:%Y%m%d}/catalog.xml')\n\n# Get list of files available for particular day\ncat = TDSCatalog(data_url)\n\n# Grab dataset for desired time\ndataset = cat.datasets.filter_time_nearest(date, regex=r'_s(?P<strptime>\\d{13})', strptime='%Y%j%H%M%S')\n\n# Open most recent file available\nds = dataset.remote_access(service='OPENDAP', use_xarray=True)\n\n# Apply a square root correction for visible imagery only\nif channel == 2:\n    ds['Sectorized_CMI'].values = np.sqrt(ds['Sectorized_CMI'].values)\n\n# Grab time from file and make into datetime object for plotting and later data access\nvtime = ds.time.values.astype('datetime64[ms]').astype('O')","key":"fDwG0yHiuo"},{"type":"outputs","id":"EpKGYYB3SySkNdWqyfs9E","children":[],"key":"Up15BjFzNl"}],"key":"OGYDEerxGm"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"lin