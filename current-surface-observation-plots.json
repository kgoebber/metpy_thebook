"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"To make a plot of surface observations requires three elements","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"adPknfgXoX"}],"key":"qtVWMidlCV"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":5,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"PlotObs()","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"euGRt9oHbR"},{"type":"text","value":" to specify the observations to be plotted","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"d8oda36jXE"}],"key":"poOBWGrUA3"}],"key":"CAdr6NCFrx"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"MapPanel()","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"g85hcNhvKi"},{"type":"text","value":" to specify the characteristics of the map to plot the observations on","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"iP7rvgfP0Z"}],"key":"WSutNAhlFS"}],"key":"KJIuBqdLKh"},{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"PanelContainer()","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"oE0fD6jaTb"},{"type":"text","value":" to collect one or more panels.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"lkIOpxjQNh"}],"key":"iX2UtV7joU"}],"key":"qG77uORbQ9"}],"key":"Au8LbClif9"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"These three elements are separate parts of the declarative module from MetPy. In Python we call these parts\nClasses and note that they contain MiXeD case names. These classes contain a number of attributes that can\nbe set to specify what and how to plot the data in a figure. The descriptions of some of the basic\nelements of each element are given below.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"D3ZMlKmv2c"}],"key":"kSVsmhCtH4"}],"key":"H6K11Shj6O"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Import Modules","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"zd3fQcw0YA"}],"identifier":"import-modules","label":"Import Modules","html_id":"import-modules","implicit":true,"key":"TnztIpdBca"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Here we’ll import those modules that are needed to produce read in remote surface METAR observation data, process those observations, and plot the values on a map.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"TvdzKblJ6K"}],"key":"FF1Lapurhh"}],"key":"m6pJkMXmfR"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from datetime import datetime, timedelta, UTC\nfrom io import StringIO\nfrom urllib.request import urlopen\n\nfrom metpy.io import metar\nfrom metpy.plots import declarative\nfrom metpy.units import units\nimport pandas as pd","key":"d0Cd0t7S4i"},{"type":"outputs","id":"-ED_sR3GmICQwZug_JMEP","children":[],"key":"KXP4HYknjq"}],"key":"wXw6iAPexm"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Read Data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"kS8hJQYFhr"}],"identifier":"read-data","label":"Read Data","html_id":"read-data","implicit":true,"key":"ZtesjtMobV"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The surface data are in METAR format and store the data files at this location for approximately two weeks.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"dI0GsVZuqW"}],"key":"YW2VWUfbza"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"The format of the filenames are ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"Ok41aDPoMV"},{"type":"inlineCode","value":"YYYYMMDDHH_sao.wmo","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"vFiVTFHTU2"},{"type":"text","value":" where ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"PzL4ndTcfz"},{"type":"inlineCode","value":"YYYY","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"m77qLqyFOo"},{"type":"text","value":" is the year, ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"o2sYzO5LBR"},{"type":"inlineCode","value":"MM","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"X8KdX5k4eE"},{"type":"text","value":" is the month, ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"tXgL03IKOH"},{"type":"inlineCode","value":"DD","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"XhxV7d1rHb"},{"type":"text","value":" is the day, and ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"WWDAa0clJX"},{"type":"inlineCode","value":"HH","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"MlZAbENlD0"},{"type":"text","value":" is the hour.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"JYWnd0hg42"}],"key":"BHQwLH1cya"}],"key":"yfV3UG6vSz"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Get the current date/time and remove the timezone information\ndate = datetime.now(UTC).replace(tzinfo=None)\n\n# Remote Access - Archive Data Read with pandas from Iowa State Archive,\n# note differences from METAR files\ndt = timedelta(minutes=30)\nsdate = date - dt\nedate = date + dt\ndata_url = ('http://mesonet.agron.iastate.edu/cgi-bin/request/asos.py?'\n            'data=all&tz=Etc/UTC&format=comma&latlon=yes&'\n            f'year1={sdate.year}&month1={sdate.month}&day1={sdate.day}'\n            f'&hour1={sdate.hour}&minute1={sdate.minute}&'\n            f'year2={edate.year}&month2={edate.month}&day2={edate.day}'\n            f'&hour2={edate.hour}&minute2={edate.minute}')\ndata = pd.read_csv(data_url, skiprows=5, na_values=['M'],\n                   low_memory=False).replace('T', 0.00001).groupby('station').tail(1)\ndf = metar.parse_metar_file(StringIO('\\n'.join(val for val in data.metar)),\n                            year=date.year, month=date.month)\n# Local Access\n# data = f'/data/ldmdata/surface/sao/{date:%Y%m%d%H}_sao.wmo'\n# df = metar.parse_metar_file(data, year=date.year, month=date.month)","key":"LW7MkaAETk"},{"type":"outputs","id":"dODxDGFT_MTNhHfNdpgz1","children":[],"key":"j06rsLJCfU"}],"key":"ds0zYv2pO8"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plot Data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"O3Nedyde8u"}],"identifier":"plot-data","label":"Plot Data","html_id":"plot-data","implicit":true,"key":"Z4X9pLkKwI"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Here we seek to use the data that were just read in to plot the ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"YR9k2EXLly"},{"type":"inlineCode","value":"air_temperature","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"qWLjbcp3gm"},{"type":"text","value":" variable in units of Fahrenheit. Since surface observations can be associated with a range of times, we can set the ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"TBclobx9L4"},{"type":"inlineCode","value":"time_window","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"SBdlrDPUBx"},{"type":"text","value":" attribute to look over a range of times. These temperatures will be plotted on a map over a small geographic location and a title is added to the map.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"KRgvuFO8NG"}],"key":"gRhi9bBUfO"}],"key":"Uua7MiLjj0"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Plot desired data\nobs = declarative.PlotObs()\nobs.data = df\nobs.time = date\nobs.time_window = timedelta(minutes=30)\nobs.fields = ['air_temperature']\nobs.plot_units = ['degF']\n\n# Panel for plot with Map features\npanel = declarative.MapPanel()\npanel.layout = (1, 1, 1)\npanel.projection = 'lcc'\npanel.area = 'in'\npanel.layers = ['states']\npanel.title = f'Air temperature on {date:%Y%m%d} at {date:%H}UTC'\npanel.plots = [obs]\n\n# Bringing it all together\npc = declarative.PanelContainer()\npc.size = (10, 10)\npc.panels = [panel]\n\npc.show()","key":"zCWdzlCWYP"},{"type":"outputs","id":"nkOUJuJ7_ZQeYt26n-dRB","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1000x1000 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"1e0e96bfd13d65c12108ee8ef0e93efa","path":"https://kgoebber.github.io/metpy_thebook//build/1e0e96bfd13d65c12108ee8ef0e93efa.png"}}},"key":"AlbDFfd5RE"}],"key":"KfHOLdlW4U"}],"key":"U7vtEEZ6UN"},{"type":"block","kind":"notebook-content","children":[{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Note","key":"bWv2rc17RY"}],"key":"jeKol2fZdA"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"The use of formatted strings (f-strings) are used extensively in this book. Use of these strings allows the easy input of variables into a string value to dynamically generate the string. Variables can also be formatted (depending on type) to gain more control over how the values plot. In the above surface plot, f-strings are used to set the title where we use the variable ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"m6YFkGsnWQ"},{"type":"inlineCode","value":"date","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"bvxydjEt2o"},{"type":"text","value":" with date formatting to make a nice, reable title.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"UcitCvL8EG"}],"key":"uSUg6LN7bF"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"For more information on f-strings, see the ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"ujZBQsFCZo"},{"type":"link","url":"https://docs.python.org/3/tutorial/inputoutput.html#formatted-string-literals","children":[{"type":"text","value":"Python documentation","key":"PoeyTDMr4a"}],"urlSource":"https://docs.python.org/3/tutorial/inputoutput.html#formatted-string-literals","key":"v0nV2z9jgq"}],"key":"E8nvyn1THQ"}],"key":"bCBN7TjBUp"}],"key":"YMUhsndjq7"}],"key":"wcPTTYZ7Fj"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Common Notebook Structure","url":"/typical-notebook-structure","group":"Introduction to Weather Technology using MetPy"},"next":{"title":"Practice Tasks - Surface Observation","url":"/practice-tasks-surface","group":"Introduction to Weather Technology using MetPy"}}},"domain":"http://localhost:3000"}