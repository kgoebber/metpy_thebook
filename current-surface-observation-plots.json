e":4,"column":1}},"children":[{"type":"text","value":"To make a plot of surface observations requires three elements","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"M8VsibWX1Z"}],"key":"ZRzopUDsU0"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":5,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"PlotObs()","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"igU8Lva23Q"},{"type":"text","value":" to specify the observations to be plotted","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"OEIsmegeiM"}],"key":"lnOM9sYUi6"}],"key":"oebzKBAxI1"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"MapPanel()","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"bL36Wz679o"},{"type":"text","value":" to specify the characteristics of the map to plot the observations on","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"MbEFlcAUP2"}],"key":"SP00vsU4L0"}],"key":"hhhayRVJ7C"},{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"PanelContainer()","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"lApitMrb4D"},{"type":"text","value":" to collect one or more panels.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"mavjZI9lxe"}],"key":"b7cbLUPkB9"}],"key":"WHRFZqEgrq"}],"key":"jWLWk76U0I"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"These three elements are separate parts of the declarative module from MetPy. In Python we call these parts\nClasses and note that they contain MiXeD case names. These classes contain a number of attributes that can\nbe set to specify what and how to plot the data in a figure. The descriptions of some of the basic\nelements of each element are given below.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"TviloeTXvg"}],"key":"DG4uL0gqEg"}],"key":"huWNTs0MCp"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Import Modules","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"augmJeRnKQ"}],"identifier":"import-modules","label":"Import Modules","html_id":"import-modules","implicit":true,"key":"J0yNymlC2E"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Here we’ll import those modules that are needed to produce read in remote surface METAR observation data, process those observations, and plot the values on a map.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"fFTEgSPCMR"}],"key":"ogYGZvVoSa"}],"key":"sBtLzq4rFN"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from datetime import datetime, timedelta, UTC\nfrom io import StringIO\nfrom urllib.request import urlopen\n\nfrom metpy.io import metar\nfrom metpy.plots import declarative\nfrom metpy.units import units\nimport pandas as pd","key":"r7Ycj3wp5D"},{"type":"outputs","id":"x8YXPqrFNezK3ZFkUxxON","children":[],"key":"HT1Jr0V5ss"}],"key":"OxGKMYHlyN"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Read Data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"yqkpqc08zf"}],"identifier":"read-data","label":"Read Data","html_id":"read-data","implicit":true,"key":"N4lKFh0548"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The surface data are in METAR format and store the data files at this location for approximately two weeks.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"D6E8x4oyLI"}],"key":"YDC1QaiGFA"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"The format of the filenames are ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"REt0PCtFoE"},{"type":"inlineCode","value":"YYYYMMDDHH_sao.wmo","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"xCAJPinIIR"},{"type":"text","value":" where ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"owJo2tfWI2"},{"type":"inlineCode","value":"YYYY","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"AYIysolkBW"},{"type":"text","value":" is the year, ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"CgxZ4pdmec"},{"type":"inlineCode","value":"MM","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"tHufzSTOg0"},{"type":"text","value":" is the month, ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"vDeojLfCEM"},{"type":"inlineCode","value":"DD","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"y7tqIh7ukJ"},{"type":"text","value":" is the day, and ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"cxp0YXzEiO"},{"type":"inlineCode","value":"HH","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"q3b9Hdz7xb"},{"type":"text","value":" is the hour.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"Tdij4S0zZJ"}],"key":"LgrNeykBJ7"}],"key":"OyClz2EHgT"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Get the current date/time and remove the timezone information\ndate = datetime.now(UTC).replace(tzinfo=None)\n\n# Remote Access - Archive Data Read with pandas from Iowa State Archive,\n# note differences from METAR files\ndt = timedelta(minutes=30)\nsdate = date - dt\nedate = date + dt\ndata_url = ('http://mesonet.agron.iastate.edu/cgi-bin/request/asos.py?'\n            'data=all&tz=Etc/UTC&format=comma&latlon=yes&'\n            f'year1={sdate.year}&month1={sdate.month}&day1={sdate.day}'\n            f'&hour1={sdate.hour}&minute1={sdate.minute}&'\n            f'year2={edate.year}&month2={edate.month}&day2={edate.day}'\n            f'&hour2={edate.hour}&minute2={edate.minute}')\ndata = pd.read_csv(data_url, skiprows=5, na_values=['M'],\n                   low_memory=False).replace('T', 0.00001).groupby('station').tail(1)\ndf = metar.parse_metar_file(StringIO('\\n'.join(val for val in data.metar)),\n                            year=date.year, month=date.month)\n# Local Access\n# data = f'/data/ldmdata/surface/sao/{date:%Y%m%d%H}_sao.wmo'\n# df = metar.parse_metar_file(data, year=date.year, month=date.month)","key":"TGiHLv7N9w"},{"type":"outputs","id":"LVU9XJHp0OqFfqM5Lb7PX","children":[],"key":"tRf7IfkmHQ"}],"key":"RNLWmvUf8D"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plot Data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"s2Cj6XZRKJ"}],"identifier":"plot-data","label":"Plot Data","html_id":"plot-data","implicit":true,"key":"Nv5lOX7OBZ"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Here we seek to use the data that were just read in to plot the ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"XhJolpapIY"},{"type":"inlineCode","value":"air_temperature","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"DbVP4rJbAp"},{"type":"text","value":" variable in units of Fahrenheit. Since surface observations can be associated with a range of times, we can set the ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"r8Dd6eZsEQ"},{"type":"inlineCode","value":"time_window","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"lZHnIl9jNh"},{"type":"text","value":" attribute to look over a range of times. These temperatures will be plotted on a map over a small geographic location and a title is added to the map.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"JpznC1xvex"}],"key":"J3tD9JdMvj"}],"key":"M4sR3lwZPs"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Plot desired data\nobs = declarative.PlotObs()\nobs.data = df\nobs.time = date\nobs.time_window = timedelta(minutes=30)\nobs.fields = ['air_temperature']\nobs.plot_units = ['degF']\n\n# Panel for plot with Map features\npanel = declarative.MapPanel()\npanel.layout = (1, 1, 1)\npanel.projection = 'lcc'\npanel.area = 'in'\npanel.layers = ['states']\npanel.title = f'Air temperature on {date:%Y%m%d} at {date:%H}UTC'\npanel.plots = [obs]\n\n# Bringing it all together\npc = declarative.PanelContainer()\npc.size = (10, 10)\npc.panels = [panel]\n\npc.show()","key":"ZVz945lqDB"},{"type":"outputs","id":"BL-VVpJASe8dT-x-5kCZO","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1000x1000 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"1e0e96bfd13d65c12108ee8ef0e93efa","path":"/build/1e0e96bfd13d65c12108ee8ef0e93efa.png"}}},"key":"mX5ii4Eamg"}],"key":"xQOXhEAxYt"}],"key":"yZgodSom8e"},{"type":"block","kind":"notebook-content","children":[{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Note","key":"KyCwTCiTPU"}],"key":"BUt5p20e5D"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"The use of formatted strings (f-strings) are used extensively in this book. Use of these strings allows the easy input of variables into a string value to dynamically generate the string. Variables can also be formatted (depending on type) to gain more control over how the values plot. In the above surface plot, f-strings are used to set the title where we use the variable ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"q6AspRlFvz"},{"type":"inlineCode","value":"date","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"alyA7xtZVm"},{"type":"text","value":" with date formatting to make a nice, reable title.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"hvjiqDKt4J"}],"key":"TLF1P5btNX"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"For more information on f-strings, see the ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"GCwaUTy7Y0"},{"type":"link","url":"https://docs.python.org/3/tutorial/inputoutput.html#formatted-string-literals","children":[{"type":"text","value":"Python documentation","key":"tJb49LbPRY"}],"urlSource":"https://docs.python.org/3/tutorial/inputoutput.html#formatted-string-literals","key":"XwPY2P7PeG"}],"key":"n3Idcby4Zw"}],"key":"qjBJh87e57"}],"key":"qADZdRZF7w"}],"key":"gkPZu8W3A9"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Common Notebook Structure","url":"/typical-notebook-structure","group":"Introduction to Weather Technology using MetPy"},"next":{"title":"Practice Tasks - Surface Observation","url":"/practice-tasks-surface","group":"Introduction to Weather Technology using MetPy"}}},"domain":"http://localhost:3001"}