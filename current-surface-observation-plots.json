e":4,"column":1}},"children":[{"type":"text","value":"To make a plot of surface observations requires three elements","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"R9JxikYr0U"}],"key":"JZ02uoagHi"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":5,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"PlotObs()","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"jgCLA3ZXKq"},{"type":"text","value":" to specify the observations to be plotted","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"PUpMSZfzFz"}],"key":"A9njHQTyXY"}],"key":"t5d8sVAi0b"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"MapPanel()","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"HRThduqx8l"},{"type":"text","value":" to specify the characteristics of the map to plot the observations on","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"IpVwbe6lMH"}],"key":"Ru0CombXF9"}],"key":"iLj8mjHU7U"},{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"paragraph","children":[{"type":"inlineCode","value":"PanelContainer()","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"ozpRV10DYS"},{"type":"text","value":" to collect one or more panels.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"pjZIGDYFmH"}],"key":"SNocH4mvH6"}],"key":"gnAa2U2FXo"}],"key":"xlq9dc9hg2"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"These three elements are separate parts of the declarative module from MetPy. In Python we call these parts\nClasses and note that they contain MiXeD case names. These classes contain a number of attributes that can\nbe set to specify what and how to plot the data in a figure. The descriptions of some of the basic\nelements of each element are given below.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"bD3oqvTw6S"}],"key":"eklqJwmcyo"}],"key":"MiYuqyWWY6"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Import Modules","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"TV9w7XocMC"}],"identifier":"import-modules","label":"Import Modules","html_id":"import-modules","implicit":true,"key":"lgtkJNCnSz"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Here we’ll import those modules that are needed to produce read in remote surface METAR observation data, process those observations, and plot the values on a map.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Tg5r3YD1U9"}],"key":"NtBEfRSIX0"}],"key":"A3ycKi4wzF"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from datetime import datetime, timedelta, UTC\nfrom io import StringIO\nfrom urllib.request import urlopen\n\nfrom metpy.io import metar\nfrom metpy.plots import declarative\nfrom metpy.units import units\nimport pandas as pd","key":"h2qK4JmSJv"},{"type":"outputs","id":"YZbaIJUuMI-ncIOQh5ao6","children":[],"key":"CEJOOcx0Gm"}],"key":"DdAd3rgVns"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Read Data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jglsyscERj"}],"identifier":"read-data","label":"Read Data","html_id":"read-data","implicit":true,"key":"Tz5LByQJvz"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The surface data are in METAR format and store the data files at this location for approximately two weeks.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"QhDyoqQtcM"}],"key":"I6RxgEwmSy"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"The format of the filenames are ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"MBfWbQl4QQ"},{"type":"inlineCode","value":"YYYYMMDDHH_sao.wmo","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"KzR0mMQYdM"},{"type":"text","value":" where ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"v8cYLo9TPI"},{"type":"inlineCode","value":"YYYY","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"ySeEammKHY"},{"type":"text","value":" is the year, ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"r3yJcI4VK1"},{"type":"inlineCode","value":"MM","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"vczXrVMEaw"},{"type":"text","value":" is the month, ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"zgKZAzrEnc"},{"type":"inlineCode","value":"DD","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"bYhuUuUKUz"},{"type":"text","value":" is the day, and ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"sWYPMyNZn0"},{"type":"inlineCode","value":"HH","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"y6ubkgyUBm"},{"type":"text","value":" is the hour.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"uuO6rxqTh5"}],"key":"ecndkktePk"}],"key":"KfUNr9Kzdx"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Get the current date/time and remove the timezone information\ndate = datetime.now(UTC).replace(tzinfo=None)\n\n# Remote Access - Archive Data Read with pandas from Iowa State Archive,\n# note differences from METAR files\ndt = timedelta(minutes=30)\nsdate = date - dt\nedate = date + dt\ndata_url = ('http://mesonet.agron.iastate.edu/cgi-bin/request/asos.py?'\n            'data=all&tz=Etc/UTC&format=comma&latlon=yes&'\n            f'year1={sdate.year}&month1={sdate.month}&day1={sdate.day}'\n            f'&hour1={sdate.hour}&minute1={sdate.minute}&'\n            f'year2={edate.year}&month2={edate.month}&day2={edate.day}'\n            f'&hour2={edate.hour}&minute2={edate.minute}')\ndata = pd.read_csv(data_url, skiprows=5, na_values=['M'],\n                   low_memory=False).replace('T', 0.00001).groupby('station').tail(1)\ndf = metar.parse_metar_file(StringIO('\\n'.join(val for val in data.metar)),\n                            year=date.year, month=date.month)\n# Local Access\n# data = f'/data/ldmdata/surface/sao/{date:%Y%m%d%H}_sao.wmo'\n# df = metar.parse_metar_file(data, year=date.year, month=date.month)","key":"Q8TaIPTQhG"},{"type":"outputs","id":"Jg10twIuodOqdJGKeCYBZ","children":[],"key":"iguQjAoFP4"}],"key":"K6hfp2Gfox"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plot Data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"WhGE8lQuaD"}],"identifier":"plot-data","label":"Plot Data","html_id":"plot-data","implicit":true,"key":"yw0FZcXddR"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Here we seek to use the data that were just read in to plot the ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"PZfXWkKKke"},{"type":"inlineCode","value":"air_temperature","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Wsl8xOF31d"},{"type":"text","value":" variable in units of Fahrenheit. Since surface observations can be associated with a range of times, we can set the ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"m6ryxz5fYL"},{"type":"inlineCode","value":"time_window","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"lD3NX17q6f"},{"type":"text","value":" attribute to look over a range of times. These temperatures will be plotted on a map over a small geographic location and a title is added to the map.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"R6dXVhEkvq"}],"key":"rSLEFw7gYL"}],"key":"hqYWi9dLbl"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Plot desired data\nobs = declarative.PlotObs()\nobs.data = df\nobs.time = date\nobs.time_window = timedelta(minutes=30)\nobs.fields = ['air_temperature']\nobs.plot_units = ['degF']\n\n# Panel for plot with Map features\npanel = declarative.MapPanel()\npanel.layout = (1, 1, 1)\npanel.projection = 'lcc'\npanel.area = 'in'\npanel.layers = ['states']\npanel.title = f'Air temperature on {date:%Y%m%d} at {date:%H}UTC'\npanel.plots = [obs]\n\n# Bringing it all together\npc = declarative.PanelContainer()\npc.size = (10, 10)\npc.panels = [panel]\n\npc.show()","key":"ZBbq9GZ8yL"},{"type":"outputs","id":"FYv7mAz7hwrEZQRNUh7_L","children":[],"key":"d2FqR4jGXA"}],"key":"grASAzeXRs"},{"type":"block","kind":"notebook-content","children":[{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Note","key":"tsay00kROD"}],"key":"zPkvaScDOE"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"The use of formatted strings (f-strings) are used extensively in this book. Use of these strings allows the easy input of variables into a string value to dynamically generate the string. Variables can also be formatted (depending on type) to gain more control over how the values plot. In the above surface plot, f-strings are used to set the title where we use the variable ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"s09uSSGKAC"},{"type":"inlineCode","value":"date","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"rtHscgrc0u"},{"type":"text","value":" with date formatting to make a nice, reable title.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"ubgIr7p81e"}],"key":"pWBo7nPRxB"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"For more information on f-strings, see the ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"G9QelVfsDd"},{"type":"link","url":"https://docs.python.org/3/tutorial/inputoutput.html#formatted-string-literals","children":[{"type":"text","value":"Python documentation","key":"FEB0CZe5Pn"}],"urlSource":"https://docs.python.org/3/tutorial/inputoutput.html#formatted-string-literals","key":"phIbEGiFfz"}],"key":"qOIddtxfTX"}],"key":"qDn6E4cBsx"}],"key":"MfkRewvrh4"}],"key":"iqUpS9rP2X"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Common Notebook Structure","url":"/typical-notebook-structure","group":"Introduction to Weather Technology using MetPy"},"next":{"title":"Practice Tasks - Surface Observation","url":"/practice-tasks-surface","group":"Introduction to Weather Technology using MetPy"}}},"domain":"http://localhost:3001"}