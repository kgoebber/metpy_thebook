:"text","value":"These three elements are separate parts of the declarative module from MetPy. In Python we call these parts\nClasses and note that they contain MiXeD case names. These classes contain a number of attributes that can\nbe set to specify what and how to plot the data in a figure. The descriptions of some of the basic\nelements of each element are given below.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"UO8NM1t6em"}],"key":"sE1v5KbntL"}],"key":"sALJSDgjdA"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Import Modules","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"iLXf5wSLP3"}],"identifier":"import-modules","label":"Import Modules","html_id":"import-modules","implicit":true,"key":"QDE0as4HYH"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Here we’ll import those modules that are needed to produce read in remote surface METAR observation data, process those observations, and plot the values on a map.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"YcgOPLiqR8"}],"key":"Zdn2acMfBn"}],"key":"zliuS4U1Ew"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from datetime import datetime, timedelta, UTC\nfrom io import StringIO\nfrom urllib.request import urlopen\n\nfrom metpy.io import metar\nfrom metpy.plots import declarative\nfrom metpy.units import units\nimport pandas as pd","key":"HTzgkn7RY0"},{"type":"outputs","id":"StErHIsK31z8FNhoYjpxI","children":[],"key":"w2RTdCHF7y"}],"key":"VESAd55w7C"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Read Data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"UCoP6L6Hsn"}],"identifier":"read-data","label":"Read Data","html_id":"read-data","implicit":true,"key":"D3nB5qnuXs"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The surface data are in METAR format and store the data files at this location for approximately two weeks.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"iN0PN0pFHT"}],"key":"dCaDgp4iQv"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"The format of the filenames are ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"iE32bLrg1M"},{"type":"inlineCode","value":"YYYYMMDDHH_sao.wmo","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"qMoo0kOHfJ"},{"type":"text","value":" where ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"GYSuxeJTSz"},{"type":"inlineCode","value":"YYYY","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"MH5zFVMzZw"},{"type":"text","value":" is the year, ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"X6XbdNw4Ax"},{"type":"inlineCode","value":"MM","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"ffISWjeo5g"},{"type":"text","value":" is the month, ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"dmHyi19yEl"},{"type":"inlineCode","value":"DD","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"JCTfi3h0UO"},{"type":"text","value":" is the day, and ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"YJm57z86p3"},{"type":"inlineCode","value":"HH","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"GA9VYlea7F"},{"type":"text","value":" is the hour.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"gjFS15ncQo"}],"key":"xw8CBndqQR"}],"key":"SXmohBF57t"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Get the current date/time and remove the timezone information\ndate = datetime.now(UTC).replace(tzinfo=None)\n\n# Remote Access - Archive Data Read with pandas from Iowa State Archive,\n# note differences from METAR files\ndt = timedelta(minutes=30)\nsdate = date - dt\nedate = date + dt\ndata_url = ('http://mesonet.agron.iastate.edu/cgi-bin/request/asos.py?'\n            'data=all&tz=Etc/UTC&format=comma&latlon=yes&'\n            f'year1={sdate.year}&month1={sdate.month}&day1={sdate.day}'\n            f'&hour1={sdate.hour}&minute1={sdate.minute}&'\n            f'year2={edate.year}&month2={edate.month}&day2={edate.day}'\n            f'&hour2={edate.hour}&minute2={edate.minute}')\ndata = pd.read_csv(data_url, skiprows=5, na_values=['M'],\n                   low_memory=False).replace('T', 0.00001).groupby('station').tail(1)\ndf = metar.parse_metar_file(StringIO('\\n'.join(val for val in data.metar)),\n                            year=date.year, month=date.month)\n# Local Access\n# data = f'/data/ldmdata/surface/sao/{date:%Y%m%d%H}_sao.wmo'\n# df = metar.parse_metar_file(data, year=date.year, month=date.month)","key":"El4Mh5PkW3"},{"type":"outputs","id":"Ibt-unZ5sl4um8fgmELTh","children":[],"key":"PBX0At9QxE"}],"key":"BGUjVJ6WRU"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plot Data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"G1Rqzi0e5e"}],"identifier":"plot-data","label":"Plot Data","html_id":"plot-data","implicit":true,"key":"sKly4CjKLR"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Here we seek to use the data that were just read in to plot the ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Wz5tNKHYMs"},{"type":"inlineCode","value":"air_temperature","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"hbG1pwaUQU"},{"type":"text","value":" variable in units of Fahrenheit. Since surface observations can be associated with a range of times, we can set the ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"qb0HQNnzWL"},{"type":"inlineCode","value":"time_window","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"uVdVP3ijy9"},{"type":"text","value":" attribute to look over a range of times. These temperatures will be plotted on a map over a small geographic location and a title is added to the map.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"p0FFy057wl"}],"key":"IQuXMmLzDT"}],"key":"urR6lOvWwv"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Plot desired data\nobs = declarative.PlotObs()\nobs.data = df\nobs.time = date\nobs.time_window = timedelta(minutes=30)\nobs.fields = ['air_temperature']\nobs.plot_units = ['degF']\n\n# Panel for plot with Map features\npanel = declarative.MapPanel()\npanel.layout = (1, 1, 1)\npanel.projection = 'lcc'\npanel.area = 'in'\npanel.layers = ['states']\npanel.title = f'Air temperature on {date:%Y%m%d} at {date:%H}UTC'\npanel.plots = [obs]\n\n# Bringing it all together\npc = declarative.PanelContainer()\npc.size = (10, 10)\npc.panels = [panel]\n\npc.show()","key":"Jm068TmbCN"},{"type":"outputs","id":"IzZQnYm-l2DzL0cO-7h5B","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1000x1000 with 1 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"1e0e96bfd13d65c12108ee8ef0e93efa","path":"https://kgoebber.github.io/metpy_thebook//build/1e0e96bfd13d65c12108ee8ef0e93efa.png"}}},"key":"OrujlFEB0j"}],"key":"eD4eFsiq77"}],"key":"WxXfcGwN1z"},{"type":"block","kind":"notebook-content","children":[{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Note","key":"na6EpknjFQ"}],"key":"KC6Z5gQobd"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"The use of formatted strings (f-strings) are used extensively in this book. Use of these strings allows the easy input of variables into a string value to dynamically generate the string. Variables can also be formatted (depending on type) to gain more control over how the values plot. In the above surface plot, f-strings are used to set the title where we use the variable ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"T9ggxPGuWo"},{"type":"inlineCode","value":"date","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"UcYFibAi0K"},{"type":"text","value":" with date formatting to make a nice, reable title.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"TbHQ9eqxHt"}],"key":"e5anEjRxzl"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"For more information on f-strings, see the ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"Xe263nr7f6"},{"type":"link","url":"https://docs.python.org/3/tutorial/inputoutput.html#formatted-string-literals","children":[{"type":"text","value":"Python documentation","key":"RcRxAHd5sJ"}],"urlSource":"https://docs.python.org/3/tutorial/inputoutput.html#formatted-string-literals","key":"wN6QY3K7Ew"}],"key":"XTKth4uq7c"}],"key":"i7mNRI0FKs"}],"key":"Pbfmtl9ZuS"}],"key":"LfplLxmvvO"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Common Notebook Structure","url":"/typical-notebook-structure","group":"Introduction to Weather Technology using MetPy"},"next":{"title":"Practice Tasks - Surface Observation","url":"/practice-tasks-surface","group":"Introduction to Weather Technology using MetPy"}}},"domain":"http://localhost:3000"}