,"value":"This notebook demonstrates using a MetPy calculation function to compute a wind speed, save it as a new varaible, and add it to the Dataset for plotting purposes.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"MyJMEputC0"}],"key":"Y0UkeYyhte"}],"key":"xyjFeerdc3"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Import Packages","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Rc5tD0O7NO"}],"identifier":"import-packages","label":"Import Packages","html_id":"import-packages","implicit":true,"key":"ZgY39NKEqp"}],"key":"Bdnl4ZciSM"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from datetime import datetime, timedelta, time, UTC\n\nimport metpy.calc as mpcalc\nfrom metpy.plots import declarative\nfrom metpy.units import units\nimport xarray as xr","key":"qPVFdnSDNS"},{"type":"outputs","id":"1g-2kSb6wkYWZd_FHUIFh","children":[],"key":"eGn54bBlx0"}],"key":"sfuEWmU4t1"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Get Data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"cAGZxwGwLA"}],"identifier":"get-data","label":"Get Data","html_id":"get-data","implicit":true,"key":"kfsUlMieQJ"}],"key":"j7Jc0T1RE7"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Set the date/time of the model run for yesterday at 00 UTC\nyesterday = datetime.now(UTC) - timedelta(days=1)\ndate = datetime.combine(yesterday, time(0))\n\n# Remote access to the dataset from the UCAR site\nds = xr.open_dataset('https://thredds.ucar.edu/thredds/dodsC/grib/NCEP/GFS/'\n                     f'Global_0p5deg_ana/GFS_Global_0p5deg_ana_{date:%Y%m%d_%H}00.grib2')\n\n# Set the plot time\nplot_time = date + timedelta(hours=0)\n\n# Subset data to be just over the U.S. for plotting purposes and for the plot_time\nds = ds.metpy.sel(lat=slice(70,10), lon=slice(360-140, 360-60))","key":"mff3mzh172"},{"type":"outputs","id":"TX4XgqdEjm0nNFPTByI6c","children":[],"key":"H3ckTqYtLF"}],"key":"pMNxRQ9foW"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Perform Calculation","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Vj4EiMdwr0"}],"identifier":"perform-calculation","label":"Perform Calculation","html_id":"perform-calculation","implicit":true,"key":"q8eNkiX96q"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Do the calculation using MetPy (not too hard).","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"pklb1CTHJS"}],"key":"XdPJVJrFBU"}],"key":"kzYaegKaHd"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Add it to the dataarray.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"STanwL6pjI"}],"key":"hoY45RyHLU"}],"key":"pRrtJXiXDY"}],"key":"SvMs3StBtW"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"All MetPy Calculations can be found at ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"EG478gzD75"},{"type":"link","url":"https://unidata.github.io/MetPy/latest/api/generated/metpy.calc.html","children":[{"type":"text","value":"https://​unidata​.github​.io​/MetPy​/latest​/api​/generated​/metpy​.calc​.html","key":"mDDv2LOBqg"}],"urlSource":"https://unidata.github.io/MetPy/latest/api/generated/metpy.calc.html","key":"QQqS06MasQ"}],"key":"D8vhqNMHX0"},{"type":"paragraph","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"Not all calculations work on grids, yet!","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"QKnAdmBBxX"}],"key":"jsy6mSuoN2"},{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"link","url":"https://unidata.github.io/MetPy/latest/api/generated/metpy.calc.wind_speed.html","children":[{"type":"text","value":"Wind Speed Calculation in MetPy","key":"NtMjHOnSap"}],"urlSource":"https://unidata.github.io/MetPy/latest/api/generated/metpy.calc.wind_speed.html","key":"X2RMXcrzYt"}],"key":"BADXEXBm3F"},{"type":"paragraph","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"We can add a new variable based on a simialr one, then update the values based on the calculation. This is easy for wind speed as it is a variant on a single component of the wind.","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"ihpoVKZ02j"}],"key":"iE0KFFe0Ws"}],"key":"Zfhec8l1mk"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Isolate needed variables for calculations\nuwnd = ds['u-component_of_wind_isobaric'].metpy.sel(time=plot_time)\nvwnd = ds['v-component_of_wind_isobaric'].metpy.sel(time=plot_time)\n\n# Calculate Wind Speed, store in Dataset\nds['wind_speed'] = mpcalc.wind_speed(uwnd, vwnd)","key":"At7JL9fi9C"},{"type":"outputs","id":"Hz18CY1a8YIVGAS6JypyH","children":[],"key":"TpIZDuYd3q"}],"key":"mxjU4yQjUk"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plot Data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"xtr3EmRpWc"}],"identifier":"plot-data","label":"Plot Data","html_id":"plot-data","implicit":true,"key":"Vo2qgF2BeV"}],"key":"o0YHIWnLyy"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Set attributes for plotting contours\ncfill = declarative.FilledContourPlot()\ncfill.data = ds\ncfill.field = 'wind_speed'\ncfill.level = 300 * units.hPa\ncfill.time = None # We subset for time already\ncfill.contours = list(range(10, 201, 20))\ncfill.colormap = 'BuPu'\ncfill.colorbar = 'horizontal'\ncfill.plot_units = 'knot'\n\ncntr2 = declarative.ContourPlot()\ncntr2.data = ds\ncntr2.field = 'Geopotential_height_isobaric'\ncntr2.level = 300 * units.hPa\ncntr2.time = plot_time\ncntr2.contours = list(range(0, 10000, 120))\ncntr2.linecolor = 'black'\ncntr2.linestyle = 'solid'\ncntr2.clabels = True\ncntr2.smooth_field = 4\n\n# Set the attributes for the map\n# and put the contours on the map\npanel = declarative.MapPanel()\npanel.area = [-125, -74, 22, 52]\npanel.projection = 'lcc'\npanel.layers = ['states', 'coastline', 'borders']\npanel.title = f'{cfill.level.m}-hPa Heights and Wind Speed at {plot_time}'\npanel.plots = [cfill, cntr2]\n\n# Set the attributes for the panel\n# and put the panel in the figure\npc = declarative.PanelContainer()\npc.size = (15, 15)\npc.panels = [panel]\n\n# Show the figure\npc.show()","key":"iZVr21JlgG"},{"type":"outputs","id":"1nlauanfXElubaEAshZGK","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1500x1500 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"cd8718b360e2e7b258872b201454d3d5","path":"https://kgoebber.github.io/metpy_thebook/build/cd8718b360e2e7b258872b201454d3d5.png"}}},"key":"huiEFn4MQK"}],"key":"yaINhS3XX0"}],"key":"IBcucuwDd2"}],"key":"TL9xvhQHB4"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Wind Speed","url":"/wind-speed","group":"Introduction to Weather Technology using MetPy"},"next":{"title":"Advection","url":"/advection-info","group":"Introduction to Weather Technology using MetPy"}}},"domain":"http://localhost:3000"}