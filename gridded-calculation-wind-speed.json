{"version":3,"kind":"Notebook","sha256":"cd5b088b3b5af8e13676d62533b0f95d621dacbb3a432cfaa78ac758bb4c7fa7","slug":"gridded-calculation-wind-speed","location":"/weather_technology/metpy_calculations/gridded_calculation_wind_speed.ipynb","dependencies":[],"frontmatter":{"title":"Wind Speed Calculation","content_includes_title":false,"kernelspec":{"name":"python3","display_name":"metpy_book","language":"python"},"license":{"content":{"id":"CC-BY-4.0","url":"https://creativecommons.org/licenses/by/4.0/","name":"Creative Commons Attribution 4.0 International","note":"All non-code content is licensed under CC-BY-4.0","free":true,"CC":true},"code":{"id":"Apache-2.0","url":"https://opensource.org/licenses/Apache-2.0","name":"Apache License 2.0","note":"All code content is licensed under Apache-2.0","free":true,"osi":true}},"github":"https://github.com/kgoebber/metpy_thebook","edit_url":null,"numbering":{"title":{"enabled":false,"offset":2},"equation":{"enabled":false},"figure":{"enabled":true,"continue":true}},"keywords":["metpy","python","meteorology","weather"],"copyright":"2026","settings":{"output_stderr":"remove-warn","output_matplotlib_strings":"remove"},"source_url":"https://github.com/kgoebber/metpy_thebook/blob/main/weather_technology/metpy_calculations/gridded_calculation_wind_speed.ipynb","exports":[{"format":"ipynb","filename":"gridded_calculation_wind_speed.ipynb","url":"/build/gridded_calculation_-240daabe3d80762c7cb9c21772c63e57.ipynb"}]},"widgets":{},"mdast":{"type":"root","children":[{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"This notebook demonstrates using a MetPy calculation function to compute a wind speed, save it as a new varaible, and add it to the Dataset for plotting purposes.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"NA4BYwZFU2"}],"key":"dn703xsYb7"}],"key":"rLFrmivDQS"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Import Packages","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"PPcfzYqV2R"}],"identifier":"import-packages","label":"Import Packages","html_id":"import-packages","implicit":true,"key":"Eg5EfDmTH6"}],"key":"N9RQ44H73f"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from datetime import datetime, timedelta, time, UTC\n\nimport metpy.calc as mpcalc\nfrom metpy.plots import declarative\nfrom metpy.units import units\nimport xarray as xr","key":"kd37ofXybf"},{"type":"outputs","id":"lVURfPXLjaxcaXDHQy2ik","children":[],"key":"UbjQNTR7LE"}],"key":"nLp1AS1SYo"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Get Data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"bpqOZNnpFM"}],"identifier":"get-data","label":"Get Data","html_id":"get-data","implicit":true,"key":"lvA4vjNR5y"}],"key":"a9ZC0hcsb6"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Set the date/time of the model run for yesterday at 00 UTC\nyesterday = datetime.now(UTC) - timedelta(days=1)\ndate = datetime.combine(yesterday, time(0))\n\n# Remote access to the dataset from the UCAR site\nds = xr.open_dataset('https://thredds.ucar.edu/thredds/dodsC/grib/NCEP/GFS/'\n                     f'Global_0p5deg_ana/GFS_Global_0p5deg_ana_{date:%Y%m%d_%H}00.grib2')\n\n# Set the plot time\nplot_time = date + timedelta(hours=0)\n\n# Subset data to be just over the U.S. for plotting purposes and for the plot_time\nds = ds.metpy.sel(lat=slice(70,10), lon=slice(360-140, 360-60))","key":"jaHAw011d4"},{"type":"outputs","id":"U-iJ8O4jg1snxQPtgpEl2","children":[],"key":"mFFGVaVpDp"}],"key":"llvdRRNniK"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Perform Calculation","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"p7ohbdsSSj"}],"identifier":"perform-calculation","label":"Perform Calculation","html_id":"perform-calculation","implicit":true,"key":"iYH9AqkpYJ"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Do the calculation using MetPy (not too hard).","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"glqbmDNoDw"}],"key":"rBrhguD4Tm"}],"key":"xgD5DsFUby"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Add it to the dataarray.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"sP1w3oMKYf"}],"key":"vC4ozNWawQ"}],"key":"jo0CTzjPdm"}],"key":"loviNu8EfI"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"All MetPy Calculations can be found at ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"VJ48kzLDuz"},{"type":"link","url":"https://unidata.github.io/MetPy/latest/api/generated/metpy.calc.html","children":[{"type":"text","value":"https://​unidata​.github​.io​/MetPy​/latest​/api​/generated​/metpy​.calc​.html","key":"sY3Cm573AQ"}],"urlSource":"https://unidata.github.io/MetPy/latest/api/generated/metpy.calc.html","key":"saDtSkw0cc"}],"key":"VwZpQPsV48"},{"type":"paragraph","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"Not all calculations work on grids, yet!","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"bnpcnxNDEF"}],"key":"DdIrVOsCNd"},{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"link","url":"https://unidata.github.io/MetPy/latest/api/generated/metpy.calc.wind_speed.html","children":[{"type":"text","value":"Wind Speed Calculation in MetPy","key":"RHjzPA0HPM"}],"urlSource":"https://unidata.github.io/MetPy/latest/api/generated/metpy.calc.wind_speed.html","key":"VK49vfP2FZ"}],"key":"vKAPDoWV9x"},{"type":"paragraph","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"We can add a new variable based on a simialr one, then update the values based on the calculation. This is easy for wind speed as it is a variant on a single component of the wind.","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"uBdOGViPxT"}],"key":"pEqWSbMUE2"}],"key":"AzddjGB4yv"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Isolate needed variables for calculations\nuwnd = ds['u-component_of_wind_isobaric'].metpy.sel(time=plot_time)\nvwnd = ds['v-component_of_wind_isobaric'].metpy.sel(time=plot_time)\n\n# Calculate Wind Speed, store in Dataset\nds['wind_speed'] = mpcalc.wind_speed(uwnd, vwnd)","key":"fa6v4cn1f3"},{"type":"outputs","id":"tTMgmvjsKjflIU_UHCtkt","children":[],"key":"QII4doiP5T"}],"key":"AJLWkDOgH5"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plot Data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"HfsAcWl4gH"}],"identifier":"plot-data","label":"Plot Data","html_id":"plot-data","implicit":true,"key":"vc6OvgRTJ2"}],"key":"HOJce2xsxU"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Set attributes for plotting contours\ncfill = declarative.FilledContourPlot()\ncfill.data = ds\ncfill.field = 'wind_speed'\ncfill.level = 300 * units.hPa\ncfill.time = None # We subset for time already\ncfill.contours = list(range(10, 201, 20))\ncfill.colormap = 'BuPu'\ncfill.colorbar = 'horizontal'\ncfill.plot_units = 'knot'\n\ncntr2 = declarative.ContourPlot()\ncntr2.data = ds\ncntr2.field = 'Geopotential_height_isobaric'\ncntr2.level = 300 * units.hPa\ncntr2.time = plot_time\ncntr2.contours = list(range(0, 10000, 120))\ncntr2.linecolor = 'black'\ncntr2.linestyle = 'solid'\ncntr2.clabels = True\ncntr2.smooth_field = 4\n\n# Set the attributes for the map\n# and put the contours on the map\npanel = declarative.MapPanel()\npanel.area = [-125, -74, 22, 52]\npanel.projection = 'lcc'\npanel.layers = ['states', 'coastline', 'borders']\npanel.title = f'{cfill.level.m}-hPa Heights and Wind Speed at {plot_time}'\npanel.plots = [cfill, cntr2]\n\n# Set the attributes for the panel\n# and put the panel in the figure\npc = declarative.PanelContainer()\npc.size = (15, 15)\npc.panels = [panel]\n\n# Show the figure\npc.show()","key":"sUJmDC1K3u"},{"type":"outputs","id":"sRrd9vN8yb3MAoa1zVuz0","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 1500x1500 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"51d94d0aeac66ad605ad5a62592cdfa2","path":"/build/51d94d0aeac66ad605ad5a62592cdfa2.png"}}},"key":"xGdhF3ZyUp"}],"key":"G9Q7Yk7mgY"}],"key":"iy5azmrwn3"}],"key":"NiZSfFdE9t"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Wind Speed","url":"/wind-speed","group":"Introduction to Weather Technology using MetPy"},"next":{"title":"Advection","url":"/advection-info","group":"Introduction to Weather Technology using MetPy"}}},"domain":"http://localhost:3001"}