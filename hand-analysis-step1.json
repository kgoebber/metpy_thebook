on":{"start":{"line":11,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":11,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"use of that pencil and eraser.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"nkH4Yvmh0D"}],"key":"W1VMscP9PX"}],"key":"FtIIheFcUZ"}],"key":"fMpHIQxHRE"}],"key":"WDvJZ8m2KN"}],"key":"nP3MRUsFEP"},{"type":"heading","depth":2,"position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"Drawing Contours","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"nYvBoEwcBS"}],"identifier":"drawing-contours","label":"Drawing Contours","html_id":"drawing-contours","implicit":true,"key":"RsMh6HFaYT"},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"strong","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"How do I draw a contour?","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"zhtmxW7mvJ"}],"key":"DpYF6hnwNo"},{"type":"text","value":" Answer:","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"TOtRKZkUHZ"}],"key":"CFvOSukeK2"},{"type":"text","value":" Interpolation","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"XUCmEnEjEW"}],"key":"qeJ0yIRVjQ"},{"type":"paragraph","position":{"start":{"line":17,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"When drawing contours of a field (also called isopleths), the\ntechnique of interpolation should be favored over extrapolation. Thus,\na contour is usually placed closer to the data point whose value is\nnearer that of the contour (","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"nYZ09b9rKT"},{"type":"crossReference","kind":"figure","identifier":"contour_draw_example","label":"contour_draw_example","children":[{"type":"text","value":"Fig. ","key":"Rf47IGyoUE"},{"type":"text","value":"12","key":"IIv8LtS7Xc"}],"template":"Figure %s","enumerator":"12","resolved":true,"html_id":"contour-draw-example","key":"n7zZugie64"},{"type":"text","value":").\nHowever, other factors, such as internal\nconsistency and the possible presence of inaccurate or ‘bad’ data\nmust also be considered. In these cases, an exact interpolation\nbetween data points in your analysis is not always the best way to go.\nParticularly in data sparse regions, you should utilize wind\ninformation to help you with your pressure or height analysis.","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"QPFuWR09Wk"}],"key":"SVjmfZCUWs"},{"type":"container","kind":"figure","children":[{"type":"image","url":"https://kgoebber.github.io/metpy_thebook//build/draw_contour_example-c5f61073245b67bbe67d3c7c8318708f.png","alt":"Example of hand drawn contours through data","width":"250px","align":"center","key":"KUxEOWghdA","urlSource":"../../images/draw_contour_example.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":34,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"contour_draw_example","identifier":"contour_draw_example","html_id":"contour-draw-example","enumerator":"12","children":[{"type":"text","value":"Figure ","key":"dIp0cvH3K4"},{"type":"text","value":"12","key":"GfNIrXNDml"},{"type":"text","value":":","key":"bawVyTsqQw"}],"template":"Figure %s:","key":"oqrvefAIuf"},{"type":"text","value":"Example of isotherms. Go through values that appear and place the line\nat the approximate location that the value of the isopleth would occur.","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"DbXa0XsnHN"}],"key":"JFsAijUCno"}],"key":"h3ZCetreYK"}],"label":"contour_draw_example","identifier":"contour_draw_example","enumerator":"12","html_id":"contour-draw-example","key":"PB7noxEJsz"},{"type":"heading","depth":2,"position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"children":[{"type":"text","value":"Missing Data","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"j7ma1P3jq3"}],"identifier":"missing-data","label":"Missing Data","html_id":"missing-data","implicit":true,"key":"lRNe9xIUI2"},{"type":"paragraph","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"strong","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"text","value":"No Data?","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"cojDL2YjFd"}],"key":"ATjpT5S2is"},{"type":"text","value":" Answer:","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"KrsjuV2JWp"}],"key":"TepHcdqws5"},{"type":"text","value":" No contours!","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"pyXs6jvKL1"}],"key":"lER1bQ7zEj"},{"type":"paragraph","position":{"start":{"line":42,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"Good synopticians do not extrapolate data contours in large data void\nregions (such as the Gulf of Mexico and the Atlantic and Pacific\nOceans on all maps, the Rockies at 850 mb, and underground areas on\nisentropic charts), as there is no data there. If the fields you are\nanalyzing appear coherent and on either side of the data void region,\nyou may connect your contours through the region using a series of\ndots in the appropriate color. This indicates that there is a\nsignificant amount of uncertainty in this area and the dots represent\na rough estimate. But one should be cautious about how you draw any\nlines through a data void region.","position":{"start":{"line":42,"column":1},"end":{"line":42,"column":1}},"key":"rI1lPZ3C4p"}],"key":"h7mwhCxdzi"},{"type":"paragraph","position":{"start":{"line":53,"column":1},"end":{"line":55,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"Under no circumstances should contours be connected by circling\naround the boundaries of a map, over oceans, or other extremely large\nbodies of water.","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"YMs6JAOVQF"}],"key":"Hx6CH0gi2z"}],"key":"HEpz5wHOvh"},{"type":"heading","depth":2,"position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"text","value":"Bad Data","position":{"start":{"line":57,"column":1},"end":{"line":57,"column":1}},"key":"gJZlhkb6cp"}],"identifier":"bad-data","label":"Bad Data","html_id":"bad-data","implicit":true,"key":"tEFwkHQ6Av"},{"type":"paragraph","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"emphasis","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"strong","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"text","value":"Is the observation bad?","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"Oz78siePwD"}],"key":"kRenUbxfAY"}],"key":"eBWveUtCcl"}],"key":"uWzARKrIua"},{"type":"paragraph","position":{"start":{"line":61,"column":1},"end":{"line":69,"column":1}},"children":[{"type":"text","value":"Be on the lookout for bad data points. If you question a particular\nvalue, check neighboring points. If they are significantly different,\nyou ","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"byO2zTpx16"},{"type":"emphasis","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"text","value":"may","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"GOZq5iPCsW"}],"key":"aRpG6Phsod"},{"type":"text","value":" want to ignore the point. Also examine the same station's\ndata at other available pressure levels. If they are also spatially\ninconsistent, you may be visiting Bad Dataville. In problem areas,\nlook at analyzing the available information several different ways and\nthen disregard any data point(s) that result in an unrealistic\nanalysis. Remember, disregarding a data point is a judgment call (as\nit may be due to a real process), but your analysis should make sense!","position":{"start":{"line":61,"column":1},"end":{"line":61,"column":1}},"key":"K6mbIEIhsr"}],"key":"dxMz0vijJl"},{"type":"paragraph","position":{"start":{"line":71,"column":1},"end":{"line":76,"column":1}},"children":[{"type":"text","value":"Be acutely aware of the presence of thunderstorms, as their effects\ncan introduce noise into a synoptic scale analysis. At the surface,\nlook for thunderstorms, lightning, heavy precipitation, gust fronts,\nmeso-highs, etc. In synoptic analyses, these effects can often be\ntreated judiciously as bad data. Remember that thunderstorms often\naffect the analysis at several levels.","position":{"start":{"line":71,"column":1},"end":{"line":71,"column":1}},"key":"KQFJIGvL7q"}],"key":"R2CP56Lro6"}],"key":"vB7dw6UOh7"}],"key":"C64zz0Qyrv"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Introduction to Hand Analysis","url":"/hand-analysis-intro","group":"Introduction to Weather Technology using MetPy"},"next":{"title":"Step 2: Meteorological Consistency","url":"/hand-analysis-step2","group":"Introduction to Weather Technology using MetPy"}}},"domain":"http://localhost:3000"}