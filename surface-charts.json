{"version":3,"kind":"Article","sha256":"fe72b2165efaa01e5df6a4c69391e0d7c7a48452d5780bbe25a88d45cdab0bd0","slug":"surface-charts","location":"/weather_technology/surface_plots/surface_charts.md","dependencies":[],"frontmatter":{"title":"Surface Observation Chart","content_includes_title":false,"license":{"content":{"id":"CC-BY-4.0","url":"https://creativecommons.org/licenses/by/4.0/","name":"Creative Commons Attribution 4.0 International","note":"All non-code content is licensed under CC-BY-4.0","free":true,"CC":true},"code":{"id":"Apache-2.0","url":"https://opensource.org/licenses/Apache-2.0","name":"Apache License 2.0","note":"All code content is licensed under Apache-2.0","free":true,"osi":true}},"github":"https://github.com/kgoebber/metpy_thebook","edit_url":null,"numbering":{"title":{"enabled":false,"offset":2},"equation":{"enabled":false},"figure":{"enabled":true,"continue":true}},"keywords":["metpy","python","meteorology","weather"],"copyright":"2026","settings":{"output_stderr":"remove-warn","output_matplotlib_strings":"remove"},"source_url":"https://github.com/kgoebber/metpy_thebook/blob/main/weather_technology/surface_plots/surface_charts.md","thumbnail":"/build/example_sfc_map_2023-47b24add5df39b11406f9fd593bae992.png","exports":[{"format":"md","filename":"surface_charts.md","url":"/build/surface_charts-68302a6aed0022852cb0ff80d75ef7bc.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"Making and reading our surface charts are important, as it is essential\nto read them quickly to diagnose the constantly changing environment. A\nsurface map can tell you a lot of information about the current\nenvironment. Observations near big bodies of water will likely have\ndiffering characteristics than stations just a little farther inland.\nAdditionally, there will be differences between observations near cities\nversus out in the middle of cornfields. These variations in\nmeteorological parameters could be very important to the future\nevolution of the weather at a given location. Therefore, it is important\nto completely understand how surface maps are created and be able to\nexplain meteorological differences between different regions.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"M62DqnUfeU"}],"key":"fCPrq6en9s"},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"strong","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Example Surface Map","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"s4TT6cADK6"}],"key":"OuXtczUjAQ"}],"key":"lKmhGiMxqw"},{"type":"paragraph","position":{"start":{"line":17,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Here is an example of a surface map (","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"B73p3PMlqF"},{"type":"crossReference","kind":"figure","identifier":"sfc_map_example","label":"sfc_map_example","children":[{"type":"text","value":"Fig. ","key":"kNEF68IoBe"},{"type":"text","value":"5","key":"gNSKgDS9h0"}],"template":"Figure %s","enumerator":"5","resolved":true,"html_id":"sfc-map-example","key":"gQrznkTBni"},{"type":"text","value":")\ncontaining many surface station models (","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"KUMyJxVtut"},{"type":"crossReference","kind":"figure","identifier":"sfc_station_model","label":"sfc_station_model","children":[{"type":"text","value":"Fig. ","key":"BumdIiLiuH"},{"type":"text","value":"4","key":"eJdl9XS4W6"}],"template":"Figure %s","enumerator":"4","resolved":true,"html_id":"sfc-station-model","remote":true,"url":"/surface-obs","dataUrl":"/surface-obs.json","key":"s9xmv3w8FB"},{"type":"text","value":")\nrepresenting surface variables using the MetPy declarative syntax. Notice\nhow we can change the colors of elements of the station model to be able to\nmore easily read the disparate pieces of information.","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"qni4gLBwpz"}],"key":"RqyA3qyGMr"},{"type":"container","kind":"figure","children":[{"type":"image","url":"/build/example_sfc_map_2023-47b24add5df39b11406f9fd593bae992.png","alt":"example surface map","width":"1000px","align":"center","key":"yujtCoB3nx","urlSource":"../../images/example_sfc_map_20230223_0000.png"},{"type":"caption","children":[{"type":"paragraph","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"captionNumber","kind":"figure","label":"sfc_map_example","identifier":"sfc_map_example","html_id":"sfc-map-example","enumerator":"5","children":[{"type":"text","value":"Figure ","key":"dq7swSxdIL"},{"type":"text","value":"5","key":"juOHiFzYxY"},{"type":"text","value":":","key":"nSaGMsDSdK"}],"template":"Figure %s:","key":"FQ2Iaw6uHd"},{"type":"text","value":"Midwest surface observations at 0000 UTC 23 February 2023.","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"B2RDJYHVTC"}],"key":"XlvUEXBnMS"}],"key":"LOcWtzHLfi"}],"label":"sfc_map_example","identifier":"sfc_map_example","enumerator":"5","html_id":"sfc-map-example","key":"fZgMyuKyme"},{"type":"paragraph","position":{"start":{"line":31,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"Now that we have learned a little bit about surface station models, let’s\nmake our own plots using the MetPy declarative syntax.","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"SuPb5UNj3T"}],"key":"j3fS6aAUvC"}],"key":"HaCYmKEQJu"}],"key":"bz6XoS6nba"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Review of Surface Station Models","url":"/surface-obs","group":"Introduction to Weather Technology usin