{"version":3,"kind":"Article","sha256":"95c1ac56e64e67e17077209a33375b02c71f9ebca05d6f90f0ed66c0526e11d9","slug":"hand-analysis-step2","location":"/weather_technology/hand_analysis/hand_analysis_step2.md","dependencies":[],"frontmatter":{"title":"Step 2: Meteorological Consistency","content_includes_title":false,"license":{"content":{"id":"CC-BY-4.0","url":"https://creativecommons.org/licenses/by/4.0/","name":"Creative Commons Attribution 4.0 International","note":"All non-code content is licensed under CC-BY-4.0","free":true,"CC":true},"code":{"id":"Apache-2.0","url":"https://opensource.org/licenses/Apache-2.0","name":"Apache License 2.0","note":"All code content is licensed under Apache-2.0","free":true,"osi":true}},"github":"https://github.com/kgoebber/metpy_thebook","edit_url":null,"numbering":{"title":{"enabled":false,"offset":2},"equation":{"enabled":false},"figure":{"enabled":true,"continue":true}},"keywords":["metpy","python","meteorology","weather"],"copyright":"2026","settings":{"output_stderr":"remove-warn","output_matplotlib_strings":"remove"},"source_url":"https://github.com/kgoebber/metpy_thebook/blob/main/weather_technology/hand_analysis/hand_analysis_step2.md","exports":[{"format":"md","filename":"hand_analysis_step2.md","url":"https://kgoebber.github.io/metpy_thebook//build/hand_analysis_step2-0b7229c0b8ae0726049959833f7e8036.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Make your analysis meteorologically consistent.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"YWiA4KWwQk"}],"key":"SN5e8PYPMz"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"text","value":"Your analysis should be consistent in both time and space. Remember\nthat the atmosphere is a fluid in which events evolving\nupstream/downstream, above/below and at previous times all influence\nthe current weather situation and this fact needs to be reflected in\nyour analyses. Examine maps from different pressure levels to make\nsure everything is consistent (e.g., a typical cyclone will tilt to\nthe west with height). If you have a time series of maps, do features\nevolve relatively smoothly or does the pattern take an unexplained\n‘jump’? If you have maps from several times at the same level and/or\nseveral levels at the same time, you can use these charts to help with\na particular analysis.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"yIEFCgcIpW"}],"key":"bndHnTcXfO"},{"type":"paragraph","position":{"start":{"line":17,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"Except for the near surface, meteorological fields are continuous and\nusually continuously differentiable. This means that your analysis\nshould be (for the most part) ","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"Yr4aaYnNvo"},{"type":"underline","children":[{"type":"strong","children":[{"type":"text","value":"smooth","key":"x9mk0CuvwT"}],"key":"Nv7jDfkoAR"}],"key":"OXag6fzfDq"},{"type":"text","value":", particularly as you move\nup through the atmosphere. Height and pressure contours should curve\nto represent the large-scale pattern, ","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"OacClKM821"},{"type":"emphasis","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"without a lot of wiggles\npresent","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"X9HUNdQ1BO"}],"key":"sSKLeFnvIC"},{"type":"text","value":". Spacing and direction of these contours should be consistent\nwith the wind information. If the height field aloft suggests the\npresence of a short wave, check to see if the wind field agrees.","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"wT3jPA9RTk"}],"key":"dHjt9ziLf1"},{"type":"heading","depth":2,"position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"Meteorological Relationships","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"ltBSqW4Ns2"}],"identifier":"meteorological-relationships","label":"Meteorological Relationships","html_id":"meteorological-relationships","implicit":true,"key":"ETHe1GoP8k"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":28,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":28,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Geostrophic wind balance","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"vJS53SNMCy"}],"key":"CyjdgWExXL"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"requires wind speeds to be greatest in regions of tightest gradient","position":{"start":{"line":29,"column":1},"end":{"line":29,"column":1}},"key":"Pa7rLkxKI6"}],"key":"rHXYcytJUX"}],"key":"p11o8PCu8f"}],"key":"OvkCZTrSsG"}],"key":"mmpphHlLAp"},{"type":"listItem","spread":true,"position":{"start":{"line":30,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Gradient wind balance","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"DuPWnalrxb"}],"key":"nj5LNHbvEp"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":31,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"