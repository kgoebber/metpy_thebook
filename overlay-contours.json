!","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"f5af8Sxgjd"}],"key":"ki90pzSPI1"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Here is some example pseudo-code to demonstrate how this would work:","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"RkVhDm2x0X"}],"key":"n48QupFGpR"},{"type":"code","lang":"python","value":"cntr = ContourPlot()  \n...  \ncntr2 = ContourPlot()  \n...  \npanel = MapPanel()  \n...  \npanel.plots = [cntr, cntr2]  \n\npc = PanelContainer()  \npc.plots = [panel]  \npc.show()\n","position":{"start":{"line":9,"column":1},"end":{"line":22,"column":1}},"key":"kW2F5cJ1KE"},{"type":"paragraph","position":{"start":{"line":23,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"When plotting two sets of contours, you’ll want to pay particular attention\nto the color and linestyle of each of the contours so that anyone reading\nyour map will be able to easily distinguish between the two sets of lines.","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"e2NIssqHdA"}],"key":"BSfwEtwZzH"},{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"Let’s see how this works using some real data and plotting two\ndifferent sets of contours.","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"C91yxH2VCn"}],"key":"e5HOjScVeP"}],"key":"U92xfYpLEj"}],"key":"c1lllDe4VD"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Plotting Grid-Relative Wind Barbs","url":"/add-grid-relative-wind-barbs","group":"Introduction to Weather Technology using MetPy"},"next":{"title":"Plotting Multiple Contours","url":"/multiple-contours","group":"Introduction to Weather Technology using MetPy"}}},"domain":"http://localhost:3000"}