Py​/latest​/api​/generated​/metpy​.calc​.html","key":"QO5CNgIOzG"}],"urlSource":"https://unidata.github.io/MetPy/latest/api/generated/metpy.calc.html","key":"QCeDhyRco0"}],"key":"uF6xDGH83p"},{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Note","key":"TlIzf4lfxw"}],"key":"UcyVaCsl1t"},{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"Not all calculations work on grids, yet!","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"M99rOKUdKk"}],"key":"SARYDGAxy8"}],"key":"ClXxwqgPXY"}],"key":"AhR6qqGNdL"},{"type":"block","kind":"notebook-content","children":[{"type":"math","value":"\\begin{align}\n\\text{Advection} = -u \\frac{\\Delta T}{\\Delta x} - v \\frac{\\Delta T}{\\Delta y}\n\\end{align}","position":{"start":{"line":1,"column":1},"end":{"line":2,"column":1}},"html":"<span class=\"katex-display\"><span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\" display=\"block\"><semantics><mtable rowspacing=\"0.25em\" columnalign=\"right\" columnspacing=\"\"><mtr><mtd class =\"mtr-glue\"></mtd><mtd><mstyle scriptlevel=\"0\" displaystyle=\"true\"><mrow><mtext>Advection</mtext><mo>=</mo><mo>−</mo><mi>u</mi><mfrac><mrow><mi mathvariant=\"normal\">Δ</mi><mi>T</mi></mrow><mrow><mi mathvariant=\"normal\">Δ</mi><mi>x</mi></mrow></mfrac><mo>−</mo><mi>v</mi><mfrac><mrow><mi mathvariant=\"normal\">Δ</mi><mi>T</mi></mrow><mrow><mi mathvariant=\"normal\">Δ</mi><mi>y</mi></mrow></mfrac></mrow></mstyle></mtd><mtd class =\"mtr-glue\"></mtd><mtd class =\"mml-eqn-num\"></mtd></mtr></mtable><annotation encoding=\"application/x-tex\">\\begin{align}\n\\text{Advection} = -u \\frac{\\Delta T}{\\Delta x} - v \\frac{\\Delta T}{\\Delta y}\n\\end{align}</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"