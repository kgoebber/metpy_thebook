ss=\"vlist\" style=\"height:1.3603em;\"><span style=\"top:-2.314em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">Δ</span><span class=\"mord mathnormal\" style=\"margin-right:0.03588em;\">y</span></span></span><span style=\"top:-3.23em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"frac-line\" style=\"border-bottom-width:0.04em;\"></span></span><span style=\"top:-3.677em;\"><span class=\"pstrut\" style=\"height:3em;\"></span><span class=\"mord\"><span class=\"mord\">Δ</span><span class=\"mord mathnormal\" style=\"margin-right:0.13889em;\">T</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8804em;\"><span></span></span></span></span></span><span class=\"mclose nulldelimiter\"></span></span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.0204em;\"><span></span></span></span></span></span></span></span><span class=\"tag\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.5204em;\"><span style=\"top:-3.5204em;\"><span class=\"pstrut\" style=\"height:3.3603em;\"></span><span class=\"eqn-num\"></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:1.0204em;\"><span></span></span></span></span></span></span></span></span>","key":"V2GjrQA3fw"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"The minus signs are by convention, which means cold air advection will be negative values and warm air advection will be positive values.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"jvB0CE5ion"}],"key":"GCdjZ3D3dI"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"link","url":"https://unidata.github.io/MetPy/latest/api/generated/metpy.calc.advection.html","children":[{"type":"text","value":"Advection Calculation in MetPy","key":"JlmKMPt9ci"}],"urlSource":"https://unidata.github.io/MetPy/latest/api/generated/metpy.calc.advection.html","key":"H7CUtEt029"}],"key":"Wy7wmtoyJn"}],"key":"LDIAdlC2hM"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Select Level and Time\nlevel = 850 * units.hPa\nplot_time = model_run_time + timedelta(hours=0)\n\n# Isolate needed variables\ntmpk = ds.Temperature_isobaric.metpy.sel(vertical=level, time=plot_time)\nuwind = ds['u-component_of_wind_isobaric'].metpy.sel(vertical=level, time=plot_time)\nvwind = ds['v-component_of_wind_isobaric'].metpy.sel(vertical=level, time=plot_time)\n\n# Copmute advection and store in Dataset\nds['temperature_advection'] = mpcalc.advection(tmpk, uwind, vwind)","key":"TvbaX6Na9C"},{"type":"outputs","id":"DweOHYoRJyvkNTnxS4D8S","children":[],"key":"TOJUA2w1r0"}],"key":"MoqD1ar1pS"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Plot Temperatue Advection","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"g1CQrtwmLP"}],"identifier":"plot-temperatue-advection","label":"Plot Temperatue Advection","html_id":"plot-temperatue-advection","implicit":true,"key":"odz3NhLQJm"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Here we plot temperature advection and we want to scale our advection to be in Celsius per 3 hours. We need to change two attributes to get there, first ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ozR2jVn1tn"},{"type":"inlineCode","value":"plot_units","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"pYDqYWo1fq"},{"type":"text","value":" we can set to ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"XzpblWFuWn"},{"type":"inlineCode","value":"degC/hour","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ypT1UzuX3n"},{"type":"text","value":", then we set the ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"IegQXqfoOk"},{"type":"inlineCode","value":"scale","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Cfy8MZJSCq"},{"type":"text","value":" attribute to ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"mGiGXJU5Ur"},{"type":"inlineCode","value":"3","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"zlJUZTTDM6"},{"type":"text","value":" to get our value over a three hour period.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"NwZLtyBOFt"}],"key":"QAefqWyN9m"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"We’ll also use the ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"fmKZ8vTo0G"},{"type":"inlineCode","value":"smooth_contour","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"hgjjkv4hH2"},{"type":"text","value":" attribute to smooth the Geopotential Heights and Temperature variables.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"TGvOkCxxpH"}],"key":"lQCLZFBZIu"}],"key":"SEc1fwRdF0"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Set attributes for plotting contours\ncfill = declarative.FilledContourPlot()\ncfill.data = ds\ncfill.field = 'temperature_advection'\ncfill.level = None # Since already chose level\ncfill.time = None # Since already chose time\ncfill.contours = list(range(-15, 16, 1))\ncfill.colormap = 'coolwarm'\ncfill.colorbar = 'horizontal'\ncfill.scale = 3\ncfill.plot_units = 'degC/hour'\n\ncntr = declarative.ContourPlot()\ncntr.data = ds\ncntr.field = 'Temperature_isobaric'\ncntr.level = level\ncntr.time = plot_time\ncntr.contours = list(range(-40, 41, 5))\ncntr.linecolor = 'red'\ncntr.linestyle = 'dashed'\ncntr.clabels = True\ncntr.plot_units = 'degC'\ncntr.smooth_contour = 4\n\ncntr2 = declarative.ContourPlot()\ncntr2.data = ds\ncntr2.field = 'Geopotential_height_isobaric'\ncntr2.level = level\ncntr2.time = plot_time\ncntr2.contours = list(range(0, 10000, 30))\ncntr2.linecolor = 'black'\ncntr2.linestyle = 'solid'\ncntr2.clabels = True\ncntr2.smooth_field = 2\ncntr2.smooth_contour = 4\n\nbarbs = declarative.BarbPlot()\nbarbs.data = ds\nbarbs.time = plot_time\nbarbs.field = ['u-component_of_wind_isobaric', 'v-component_of_wind_isobaric']\nbarbs.level = level\nbarbs.skip = (3, 3)\nbarbs.plot_units = 'knot'\n\n# Set the attributes for the map\n# and put the contours on the map\npanel = declarative.MapPanel()\npanel.area = [-125, -74, 20, 55]\npanel.projection = 'lcc'\npanel.layers = ['states', 'coastline', 'borders']\npanel.title = f'850-hPa Temperature Advection at {plot_time} by KHG'\npanel.plots = [cfill, cntr, cntr2, barbs]\n\n# Set the attributes for the panel\n# and put the panel in the figure\npc = declarative.PanelContainer()\npc.size = (15, 15)\npc.panels = [panel]\n\n# Show the figure\npc.show()","key":"dkqsZIjbtk"},{"type":"outputs","id":"XP3xHPxGdozlHKkUZCFB7","children":[],"key":"GH15EBj9bI"}],"key":"d2lQYPtRPM"}],"key":"VqgDChul9g"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Advection","url":"/advection-info","group":"Introduction to Weather Technology using MetPy"},"next":{"title":"Relative Vorticity","url":"/relative-vorticity-info","group":"Introduction to Weather Technology using MetPy"}}},"domain":"http://localhost:3001"}