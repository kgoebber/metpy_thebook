,"column":1}},"key":"fTZX1AFLog"}],"key":"lHrsmMFDeW"},{"type":"paragraph","position":{"start":{"line":19,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"link","url":"https://docs.python.org/3/tutorial/datastructures.html#dictionaries","children":[{"type":"text","value":"Python Docs: Dictionaries","key":"WIfyM6BE9o"}],"urlSource":"https://docs.python.org/3/tutorial/datastructures.html#dictionaries","key":"boClBMriKv"}],"key":"igE51jZjE8"}],"key":"oPnydRdUqM"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"units = {'tmpf': 'F', 'dwpf': 'F', 'pressure': 'hPa'}\nlong_names = {'tmpf': 'Temperature', 'dwpf': 'Dewpoint', 'pressure': 'Pressure'}","key":"YJCjhSMpNs"},{"type":"outputs","id":"pRjjbWLcv-q8PPx9LUXDh","children":[],"key":"cP3zfE9HVA"}],"key":"i4BtpnBBds"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"print(long_names['tmpf'])","key":"bSJZ7mr9IU"},{"type":"outputs","id":"LME5h25pfvC_swtPcaGhs","children":[],"key":"yJXG93eRLF"}],"key":"SExl4mmGMR"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Numpy Arrays","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vNFZ3bDjic"}],"identifier":"numpy-arrays","label":"Numpy Arrays","html_id":"numpy-arrays","implicit":true,"key":"vb8pFyaq3c"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"A data object that is very import to scientists using computers is to have a true array, meaning one that we can do math on and have it automatically calculate element by element. Unfortunately, lists won’t work as we have seen, so we need to bring in a third-party package (module) that contains this type of data object. Through the course of the semester we will interact with many more data objects that will be useful for our work in Earth Systems Science.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"QechcptWdD"}],"key":"GBqkk7zFDR"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"The Numpy module is a powerful package that includes not only a true array object, but a number of important calculations that can operate on these arrays in a time efficient manner. We’ll dig deeper into all that Numpy as to offer in the next unit, but for now we want to introduce importing a third-party package and the development of a Numpy array.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"tcTnSTH3Nz"}],"key":"cZK44hbI64"}],"key":"HticSy1LP7"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Importing a Module","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"wbVvqjMVlp"}],"identifier":"importing-a-module","label":"Importing a Module","html_id":"importing-a-module","implicit":true,"key":"X2xYxpW7k4"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"There are many, many, many packages that have been developed to work off of the main Python syntax core, which is relatively small in and of itself. To gain access to those packages, they need to be imported to attach the methods contained within to your notebook/script. There are some common ways to import many packages and we’ll use the most common methods over the course of this semester.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"YIIbPhrjci"}],"key":"UhTUhOl7xo"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"t