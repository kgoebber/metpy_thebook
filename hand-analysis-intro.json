{"version":3,"kind":"Article","sha256":"f8052a009082a95431cd82dd93cbcce53ab1aaf5c3487310ca856ed20acddaba","slug":"hand-analysis-intro","location":"/weather_technology/hand_analysis/hand_analysis_intro.md","dependencies":[],"frontmatter":{"title":"Introduction to Hand Analysis","content_includes_title":false,"license":{"content":{"id":"CC-BY-4.0","url":"https://creativecommons.org/licenses/by/4.0/","name":"Creative Commons Attribution 4.0 International","note":"All non-code content is licensed under CC-BY-4.0","free":true,"CC":true},"code":{"id":"Apache-2.0","url":"https://opensource.org/licenses/Apache-2.0","name":"Apache License 2.0","note":"All code content is licensed under Apache-2.0","free":true,"osi":true}},"github":"https://github.com/kgoebber/metpy_thebook","edit_url":null,"numbering":{"title":{"enabled":false,"offset":1},"equation":{"enabled":false},"figure":{"enabled":true,"continue":true}},"keywords":["metpy","python","meteorology","weather"],"copyright":"2026","settings":{"output_stderr":"remove-warn","output_matplotlib_strings":"remove"},"source_url":"https://github.com/kgoebber/metpy_thebook/blob/main/weather_technology/hand_analysis/hand_analysis_intro.md","exports":[{"format":"md","filename":"hand_analysis_intro.md","url":"/build/hand_analysis_intro-0456ae14cc925b7acc1a7ced125e7f2d.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"Map analysis is still a large part of what a meteorologist does every\nsingle day. This larger concept of “map analysis” includes the drawing\nof contours of temperature, pressure, and height as well as analyzing\nfronts, troughs, ridges, etc. The guidelines contained in this chapter\nare a compilation of good rules of thumb and techniques for identifying\nmany different meteorological phenomena on weather maps. You may not\nalways physically draw out the contours or analyze fronts, but you will\nalways need to be able to identify all of the different aspects of the\nweather to be able to conduct a weather discussion or doing research.\nTherefore, developing the skills of map analysis will serve you well\nthroughout your meteorological career.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"OnUb64o7eQ"}],"key":"IOuGjAqQE9"},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"This set of guidelines will start with a description of hand analysis\n(e.g., the drawing of contours) on surface and upper-air weather maps.\nThen the discussion will turn to analyzing maps that are already\ncontoured with the basic parameters, whether hand or computer drawn.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"tJ6sh6K3wD"}],"key":"hjJE4isLeA"},{"type":"paragraph","position":{"start":{"line":20,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"text","value":"This chapter provides you with an introduction to the methods of\nsynoptic map analysis. It is by no means an all-inclusive guide, but\nserves as a good outline on the proper techniques of analysis. You will\nbe expected to refer to this information for general synoptic analysis\ntechniques throughout your career.","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"H6bIbCL0El"}],"key":"ChSPI0Rxhj"},{"type":"heading","depth":2,"position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"children":[{"type":"text","value":"Tools","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"eiQsxlwb5q"}],"identifier":"tools","label":"Tools","html_id":"tools","implicit":true,"key":"ngPH5HI8hO"},{"type":"paragraph","position":{"start":{"line":28,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"There are a number of tools that are useful for conducting a successful\nhand analysis.","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"tGnt4xn4ZU"}],"key":"FU4siEYDGx"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":30,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Pencil","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"iqVnBJW84j"}],"key":"xOshGMqUHk"}],"key":"OzllqW2idd"},{"type":"listItem","spread":true,"position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Fine tip pens (black, blue, green, red, yellow, brown, purple, and orange)","position":{"start":{"line":31,"column":1},"end":{"line":31,"column":1}},"key":"HzpTWmWNDy"}],"key":"HhTUoc5BTa"}],"key":"qLxrGuujXe"},{"type":"listItem","spread":true,"position":{"start":{"line":32,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Colored pencils (blue, brown, green, red, purple, yellow)","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"dWiRcyfExv"}],"key":"fR8boK1nQl"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"including multiple shades of blue, green","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"fy9IqmPHRY"}],"key":"VRHqd4gtQf"}],"key":"aWudk1oZ1Q"}],"key":"aLK33Gd9r3"}],"key":"wFCLgdnabv"},{"type":"listItem","spread":true,"position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Good eraser","position":{"start":{"line":34,"column":1},"end":{"line":34,"column":1}},"key":"JNzkPfWkdz"}],"key":"eKwnYYAisJ"}],"key":"CrrDxyKUwF"},{"type":"listItem","spread":true,"position":{"start":{"line":35,"column":1},"end":{"line":36,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Lots of patience","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"o5WivdEzMF"}],"key":"ex2E75KjnK"}],"key":"EOizQinOqS"}],"key":"g3yQaRFqWY"},{"type":"heading","depth":2,"position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"General Tip","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"mV0zYwqypd"}],"identifier":"general-tip","label":"General Tip","html_id":"general-tip","implicit":true,"key":"NPjCOvz55C"},{"type":"paragraph","position":{"start":{"line":39,"column":1},"end":{"line":42,"column":1}},"children":[{"type":"text","value":"The most important thing to remember when analyzing maps is that it\nrequires ","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"JDgEuouwUA"},{"type":"strong","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"underline","children":[{"type":"text","value":"time","key":"UC1CSgyHwl"}],"key":"iFrmwCVynC"}],"key":"fkn2qSf6Qa"},{"type":"text","value":" to do a good job. You are contouring values in\na fluid; actual values may change quickly, but the gradient of values\nchange more gradually.","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"J8IPxoHO1O"}],"key":"Y4rfQDBq0n"}],"key":"da3rCvA7j7"}],"key":"GIWx308nny"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Practice Tasks - Upperair Maps","url":"/upperair-practice-tasks","group":"Introduction to Weather Technology using MetPy"},"next":{"title":"Step 1: Draw Contours In Pencil","url":"/hand-analysis-step1","group":"Introduction to Weather Technology using MetPy"}}},"domain":"http://localhost:3001"}