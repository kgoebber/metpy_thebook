{"version":3,"kind":"Article","sha256":"78c3fdf2320bdca5cf0f648cecbf05b20b8cadb9ad723cbc60b11748b65910e6","slug":"basic-html","location":"/introduction/basic_html.md","dependencies":[],"frontmatter":{"title":"Hypertext Markup Language (HTML)","content_includes_title":false,"license":{"content":{"id":"CC-BY-4.0","url":"https://creativecommons.org/licenses/by/4.0/","name":"Creative Commons Attribution 4.0 International","note":"All non-code content is licensed under CC-BY-4.0","free":true,"CC":true},"code":{"id":"Apache-2.0","url":"https://opensource.org/licenses/Apache-2.0","name":"Apache License 2.0","note":"All code content is licensed under Apache-2.0","free":true,"osi":true}},"github":"https://github.com/kgoebber/metpy_thebook","edit_url":null,"numbering":{"title":{"enabled":false,"offset":1},"equation":{"enabled":false},"figure":{"enabled":true,"continue":true}},"keywords":["metpy","python","meteorology","weather"],"copyright":"2026","settings":{"output_stderr":"remove-warn","output_matplotlib_strings":"remove"},"source_url":"https://github.com/kgoebber/metpy_thebook/blob/main/introduction/basic_html.md","exports":[{"format":"md","filename":"basic_html.md","url":"https://kgoebber.github.io/metpy_thebook//build/basic_html-84ae3b4a43a5cc5498733d1f50d111a4.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"How do we go about disseminating meteorological information? Well, there\nare actually a number of different mechanisms to do so including,\ntelevision, radio, newspaper, fax machine, and the Internet. Since the\nadvent of the Internet, dissemination of all types of meteorological\ninformation has gotten easier. Previously, difax (digital fax) maps were\nthe primary mechanism to view weather data. We used to hang maps on the\nwall; it was a legacy from the era before high-speed Internet. With the\nInternet we can post many more images than what would be transmitted via\nfax, in a better quality, with color! So it is important to know at\nleast the very basics of how to construct a simple html page and putting\nimages and text on them for public consumption.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"OS9aFpFCxo"}],"key":"XwjFjgWVM7"},{"type":"paragraph","position":{"start":{"line":15,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"As part of your account on bergeron and us placing an Apache server on\nit, you all have the ability to create a public html page. This page\nshould only be used for generally meteorological purposes and we’ll use\nit for the remainder of the semester for our assignments and the\nsemester project. First, we need to get everyone started, so we will\nmake a simple webpage using the tag language of html. You’ll be\nintroduced to the most common tags that are used in creating an html\npage. You can create a webpage through other means, such as PHP, but we\nwill keep it to the basics here.","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"xkHzLBnxEo"}],"key":"KaPe6N8syk"},{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Note","key":"W1Eud5wRU8"}],"key":"PcYiAvHYBQ"},{"type":"paragraph","position":{"start":{"line":26,"column":1},"end":{"line":29,"column":1}},"children":[{"type":"text","value":"The following commands are going to be different depending on how and where\nyou are creating a website. The HTML tags are applicable across systems. So\nyou may need to create any HTML pages in a different location/manner, but\nthe contents of a simple example webpage would be the same.","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"osh418sAlq"}],"key":"wveHe9ZrVH"}],"key":"VG2talixKm"},{"type":"heading","depth":2,"position":{"start":{"line":32,"column":1},"end":{"line":32,"column":