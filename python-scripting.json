{"version":3,"kind":"Article","sha256":"b182cf5ea04bfaf94d5e94902c8ba0349e902a5f9a00b2ce0521111f9b4eb9bc","slug":"python-scripting","location":"/python_basics/python_scripting.md","dependencies":[],"frontmatter":{"title":"Python Script","content_includes_title":false,"license":{"content":{"id":"CC-BY-4.0","url":"https://creativecommons.org/licenses/by/4.0/","name":"Creative Commons Attribution 4.0 International","note":"All non-code content is licensed under CC-BY-4.0","free":true,"CC":true},"code":{"id":"Apache-2.0","url":"https://opensource.org/licenses/Apache-2.0","name":"Apache License 2.0","note":"All code content is licensed under Apache-2.0","free":true,"osi":true}},"github":"https://github.com/kgoebber/metpy_thebook","edit_url":null,"numbering":{"title":{"enabled":false,"offset":1},"equation":{"enabled":false},"figure":{"enabled":true,"continue":true}},"keywords":["metpy","python","meteorology","weather"],"copyright":"2026","settings":{"output_stderr":"remove-warn","output_matplotlib_strings":"remove"},"source_url":"https://github.com/kgoebber/metpy_thebook/blob/main/python_basics/python_scripting.md","exports":[{"format":"md","filename":"python_scripting.md","url":"https://kgoebber.github.io/metpy_thebook//build/python_scripting-3bdeec4eaf0f1a8bbf8d865a964daf9a.md"}]},"mdast":{"type":"root","children":[{"type":"block","children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"A Python script is essentially a list of statements entered into a text\nfile that will be executed by the Python interpreter in the order in\nwhich they are written in the file. A key benefit of using a script is\nto define variables and not having to type them out every time that you\nwant to perform a series of tasks to create a desired output in a\nnotebook environment.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"QZXq2agalY"}],"key":"NrdMcpoFkP"},{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"text","value":"It is relatively easy to use some Python scripting to ease various\ntasks, including map making. During this section we will see how you can\nturn a notebook file into a script to make it easier to reproduce the\ndesired output with less effort than opening a notebook file and running\nall of the cells.","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"KImN5MYa6U"}],"key":"nqfBxqIMx3"},{"type":"heading","depth":2,"position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"Hello World Script","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"g8WPr9o8MX"}],"identifier":"hello-world-script","label":"Hello World Script","html_id":"hello-world-script","implicit":true,"key":"u5fV1fRAVy"},{"type":"paragraph","position":{"start":{"line":18,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"Let’s start very simply by creating a simple Python script that prints\nthe statement ‘Hello World!’!","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"X4gj8ORGmX"}],"key":"zXxkzS9a5Y"},{"type":"paragraph","position":{"start":{"line":21,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"Open a new file using vi by typing the following in a new terminal\nwindow:","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"h0gEUvQaip"}],"key":"qicoyywMut"},{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"inlineCode","value":"kgoebber@bergeron:~> vi script1.py","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"ziYUzA1cDc"}],"key":"StMm7EmgPQ"},{"type":"paragraph","position":{"start":{"line":26,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"Now add the following code to your script, save the output, and quit the\nfile.","position":{"start":{"line":26,"column":1},"end":{"line":26,"column":1}},"key":"lhe8883RJh"}],"key":"MnKzWbd4Cs"},{"type":"code","lang":"python","value":"# Print the following statement to standard output\n\nprint('Hello World')","position":{"start":{"line":29,"column":1},"end":{"line":33,"column":1}},"key":"l31YyiU8WZ"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":37,"column":1}},"children":[{"type":"text","value":"Once you are back at the terminal prompt we now want to run our script.\nTo run a python script we want to run our file through the Python\ninterpreter which we can do by typing the following in the terminal:","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"Mrx8E6GDju"}],"key":"d83KE2iHPu"},{"type":"paragraph","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"inlineCode","value":"kgoebber@bergeron:~> python script1.py","position":{"start":{"line":39,"column":1},"end":{"line":39,"column":1}},"key":"XhaixfSPg4"}],"key":"PGeEmtfYsm"},{"type":"paragraph","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"The output should be:","position":{"start":{"line":41,"column":1},"end":{"line":41,"column":1}},"key":"NscB3Lj16A"}],"key":"xvDaQpVSev"},{"type":"paragraph","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"inlineCode","value":"Hello World!","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"HmDjTghNzr"}],"key":"KGbIJFT4VG"},{"type":"paragraph","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"And that’s it! You just wrote and ran your first Python script!","position":{"start":{"line":45,"column":1},"end":{"line":45,"column":1}},"key":"MchYHFWkmp"}],"key":"LIUqJtacrg"},{"type":"paragraph","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"Now let’s develop a bit more into a simple script.","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"XCZ5UZYHOp"}],"key":"eC1lJrYaYx"},{"type":"heading","depth":2,"position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"children":[{"type":"text","value":"Building a full Python script","position":{"start":{"line":49,"column":1},"end":{"line":49,"column":1}},"key":"Oyl9M8BNvp"}],"identifier":"building-a-full-python-script","label":"Building a full Python script","html_id":"building-a-full-python-script","implicit":true,"key":"PBn3650vGt"},{"type":"paragraph","position":{"start":{"line":51,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"text","value":"Open a new text file from the terminal window (or the terminal from the\nJupyter Lab Launcher window) using vi (or any other text editing tool you\nmight know) and call it ","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"hEN7miPLwA"},{"type":"emphasis","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"strong","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"my_script.py","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"a0dFgni9vI"}],"key":"iBTxYQrtJK"}],"key":"CadWktKyIo"},{"type":"text","value":". Once the new file is open the\nfirst thing you will want to add some lines that describe the script and\nwhat it does. This is called a comment block. Recall that a comment in Python\ncode begins with the pound (hashtag) sign (","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"vUpQaxTI3O"},{"type":"inlineCode","value":"#","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"FQM0Dvlo79"},{"type":"text","value":"). You may add something like\nthe following for your initial comment block:","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"skGCN1A0Tl"}],"key":"hdcU6Db68D"},{"type":"code","lang":"python","value":"############################################################\n# my_script.py\n# By: Kevin Goebbert\n#\n# This is a simple test script. It uses basic\n# Python datetime commands to do a few simple\n# tasks.\n#\n# Modifications:\n#\n############################################################","position":{"start":{"line":59,"column":1},"end":{"line":71,"column":1}},"key":"SAq9UvmoKf"},{"type":"paragraph","position":{"start":{"line":73,"column":1},"end":{"line":75,"column":1}},"children":[{"type":"text","value":"All of the previous is just for your information, so that you can\nquickly understand what you were trying to do with this particular\nscript. Now let’s add something to the script to make it do something!","position":{"start":{"line":73,"column":1},"end":{"line":73,"column":1}},"key":"TKkasQOqie"}],"key":"x8ff9aQTRk"},{"type":"code","lang":"python","value":"from datetime import datetime\n\n# This is a comment and not executed\n\nprint(\"Hello, this is my first script.\")\n\n# Get current time from computer\n\nnow = datetime.now()\n\nprint(f\"The current time is {now}\")\n\n# Get current time in UTC from computer\n\nnow_utc = datetime.utcnow()\n\nprint(f\"The current time in UTC is {now_utc}\")\n\nprint(f\"The current month is {now_utc:%B}\")\n\nprint(\"All done\")","position":{"start":{"line":77,"column":1},"end":{"line":99,"column":1}},"key":"kQvOwkqz3O"},{"type":"paragraph","position":{"start":{"line":101,"column":1},"end":{"line":102,"column":1}},"children":[{"type":"text","value":"After you enter all of the above, ","position":{"start":{"line":101,"column":1},"end":{"line":101,"column":1}},"key":"dctbtQsbWt"},{"type":"emphasis","position":{"start":{"line":101,"column":1},"end":{"line":101,"column":1}},"children":[{"type":"text","value":"write the file and quit","position":{"start":{"line":101,"column":1},"end":{"line":101,"column":1}},"key":"ODAcwPn4Ky"}],"key":"rXZvkMXv64"},{"type":"text","value":" to get back\nto your command prompt.","position":{"start":{"line":101,"column":1},"end":{"line":101,"column":1}},"key":"vhpvPYvQ9P"}],"key":"fe3osGv3sb"},{"type":"admonition","kind":"note","children":[{"type":"admonitionTitle","children":[{"type":"text","value":"Note","key":"i8qqF9exsL"}],"key":"oMjqYGcVe1"},{"type":"paragraph","position":{"start":{"line":106,"column":1},"end":{"line":110,"column":1}},"children":[{"type":"text","value":"Be careful with all of these quote marks. Be sure to have balance\nsingle/double quotes. If in one of the print statements we need to use\nnested quote marks. It doesn’t matter which is used\nwhere, just that you use different ones within the nest from what was used\non the outer quote marks.","position":{"start":{"line":106,"column":1},"end":{"line":106,"column":1}},"key":"nUMpq97QMy"}],"key":"HGC6bSuJZU"}],"key":"Z7qoKK9UfC"},{"type":"paragraph","position":{"start":{"line":113,"column":1},"end":{"line":114,"column":1}},"children":[{"type":"text","value":"Again, recall that in order to execute a Python script, type the\nfollowing on your terminal window at the command prompt","position":{"start":{"line":113,"column":1},"end":{"line":113,"column":1}},"key":"WZ4JkBqQWD"}],"key":"Yek9LtguOG"},{"type":"paragraph","position":{"start":{"line":116,"column":1},"end":{"line":116,"column":1}},"children":[{"type":"inlineCode","value":"kgoebber@bergeron:~> python <yourfile>","position":{"start":{"line":116,"column":1},"end":{"line":116,"column":1}},"key":"ndsbst8LQ8"}],"key":"yBNsFme5MR"},{"type":"paragraph","position":{"start":{"line":118,"column":1},"end":{"line":119,"column":1}},"children":[{"type":"text","value":"where ","position":{"start":{"line":118,"column":1},"end":{"line":118,"column":1}},"key":"KYXBZTbcNQ"},{"type":"inlineCode","value":"<yourfile>","position":{"start":{"line":118,"column":1},"end":{"line":118,"column":1}},"key":"vGkh1zuiOv"},{"type":"text","value":" in this name that you gave to your script file (e.g.,\n","position":{"start":{"line":118,"column":1},"end":{"line":118,"column":1}},"key":"uWjWDUXHX4"},{"type":"emphasis","position":{"start":{"line":118,"column":1},"end":{"line":118,"column":1}},"children":[{"type":"inlineCode","value":"example_script.py","position":{"start":{"line":118,"column":1},"end":{"line":118,"column":1}},"key":"dtFDqfvDWS"}],"key":"Nol7LCc15F"},{"type":"text","value":"). Go ahead and run the file.","position":{"start":{"line":118,"column":1},"end":{"line":118,"column":1}},"key":"Y6yCbrKtfe"}],"key":"KKyLArKXDN"},{"type":"paragraph","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"children":[{"type":"text","value":"What happened? Run it again, did anything change?","position":{"start":{"line":121,"column":1},"end":{"line":121,"column":1}},"key":"Ae1SNwDPTA"}],"key":"mHgznAEM7j"}],"key":"BaLKUWtwMW"}],"key":"f0iLNq9Syv"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Datetime Functionality","url":"/datetime-timedelta-time","group":"Introduction to Weather Technology using MetPy"},"next":{"title":"Runtime Control with Scripts","url":"/advanced-script-control","group":"Introduction to Weather Technology using MetPy"}}},"domain":"http://localhost:3000"}